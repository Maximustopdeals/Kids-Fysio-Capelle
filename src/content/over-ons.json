{"html": "<style>\n        /* ─── PREMIUM ROOT VARIABLES ─── */\n        :root {\n            --primary: #1a5c47;\n            --primary-light: #2a7d62;\n            --primary-pale: #b5dfcb;\n            --primary-bg: #f0f9f5;\n            --white: #ffffff;\n            --text-dark: #1e2b2a;\n            --text-muted: #4a5f5c;\n            --shadow-sm: 0 4px 20px rgba(0,0,0,0.06);\n            --shadow-lg: 0 30px 80px rgba(0,0,0,0.12);\n            --radius: 20px;\n            --radius-sm: 12px;\n            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n        }\n\n        /* ─── RESET & BASE ─── */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Open Sans', sans-serif;\n            background: var(--white);\n            color: var(--text-dark);\n            line-height: 1.8;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 24px;\n        }\n\n        /* ─── TYPOGRAPHY ─── */\n        h1, h2, h3, h4 {\n            font-family: 'Nunito', sans-serif;\n            font-weight: 800;\n            line-height: 1.25;\n        }\n\n        h1 { font-size: 3.8rem; letter-spacing: -0.02em; }\n        h2 { font-size: 2.6rem; letter-spacing: -0.01em; }\n        h3 { font-size: 1.8rem; }\n        h4 { font-size: 1.3rem; }\n\n        /* ─── HERO SECTION ─── */\n        .hero {\n            position: relative;\n            min-height: 70vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: linear-gradient(165deg, #0d2f26 0%, #1a5c47 40%, #2a7d62 100%);\n            overflow: hidden;\n            isolation: isolate;\n        }\n\n        /* Achtergrondfoto met lazy loading */\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            background: url('/images/KidsFysioCapelle-De-praktijk-1.webp') center/cover no-repeat;\n            opacity: 0.15;\n            transform: scale(1.05);\n            will-change: transform;\n            transition: transform 8s ease;\n        }\n\n        .hero:hover .hero-bg {\n            transform: scale(1.1);\n        }\n\n        .hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: \n                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(181, 223, 203, 0.12) 0%, transparent 70%),\n                radial-gradient(ellipse 60% 50% at 80% 20%, rgba(181, 223, 203, 0.06) 0%, transparent 60%);\n            z-index: 1;\n        }\n\n        .hero::after {\n            content: '';\n            position: absolute;\n            top: -30%;\n            right: -10%;\n            width: 600px;\n            height: 600px;\n            background: radial-gradient(circle, rgba(181, 223, 203, 0.05) 0%, transparent 70%);\n            border-radius: 50%;\n            z-index: 1;\n        }\n\n        .hero-pattern {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            opacity: 0.03;\n            background-image: \n                radial-gradient(circle at 20% 50%, var(--white) 1px, transparent 1px),\n                radial-gradient(circle at 80% 20%, var(--white) 1px, transparent 1px);\n            background-size: 60px 60px;\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 2;\n            max-width: 900px;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 10px 28px;\n            background: rgba(255,255,255,0.10);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255,255,255,0.15);\n            border-radius: 100px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            color: rgba(255,255,255,0.95);\n            letter-spacing: 0.3px;\n            margin-bottom: 32px;\n            animation: fadeDown 0.8s ease both;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            fill: currentColor;\n        }\n\n        .hero h1 {\n            color: var(--white);\n            margin-bottom: 20px;\n            animation: fadeUp 0.8s ease 0.15s both;\n        }\n\n        .hero h1 span {\n            background: linear-gradient(135deg, var(--primary-pale), #e8f5ef);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.35rem;\n            color: rgba(255,255,255,0.85);\n            max-width: 700px;\n            margin: 0 auto;\n            font-weight: 400;\n            line-height: 1.6;\n            animation: fadeUp 0.8s ease 0.3s both;\n        }\n\n        .hero-cta {\n            margin-top: 40px;\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            animation: fadeUp 0.8s ease 0.45s both;\n        }\n\n        .btn {\n            padding: 16px 38px;\n            border-radius: 100px;\n            font-family: 'Nunito', sans-serif;\n            font-weight: 700;\n            font-size: 1.05rem;\n            text-decoration: none;\n            transition: var(--transition);\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--white);\n            color: var(--primary);\n            box-shadow: 0 8px 32px rgba(0,0,0,0.20);\n        }\n        .btn-primary:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 16px 48px rgba(0,0,0,0.30);\n        }\n\n        .btn-outline {\n            background: transparent;\n            color: var(--white);\n            border: 2px solid rgba(255,255,255,0.30);\n        }\n        .btn-outline:hover {\n            background: rgba(255,255,255,0.10);\n            border-color: rgba(255,255,255,0.60);\n            transform: translateY(-3px);\n        }\n\n        /* ─── ANIMATIONS ─── */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        @keyframes fadeDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ─── SECTION STYLING ─── */\n        section {\n            padding: 80px 0;\n        }\n\n        .section-intro {\n            text-align: center;\n            max-width: 780px;\n            margin: 0 auto 60px;\n        }\n\n        .section-intro h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .section-intro h2::after {\n            content: '';\n            display: block;\n            width: 70px;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            margin: 18px auto 0;\n            border-radius: 4px;\n        }\n\n        .section-intro p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            margin-top: 20px;\n        }\n\n        /* ─── CONTENT GRID ─── */\n        .grid-2 {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 60px;\n            align-items: center;\n        }\n\n        .grid-2 .image-wrap {\n            border-radius: var(--radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n            transition: var(--transition);\n        }\n        .grid-2 .image-wrap:hover {\n            transform: scale(1.01) translateY(-4px);\n        }\n        .grid-2 .image-wrap img {\n            width: 100%;\n            height: 420px;\n            object-fit: cover;\n            display: block;\n        }\n\n        .grid-2 .text-content h3 {\n            color: var(--primary);\n            margin-top: 0;\n        }\n\n        /* ─── TEAM GRID 2x2 (professioneel en ruim) ─── */\n        .team-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        .team-card {\n            background: var(--white);\n            padding: 35px 30px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .team-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .team-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        /* ─── AVATAR - VASTE AFMETINGEN, ALLE FOTO'S EVEN GROOT ─── */\n        .team-card .avatar {\n            width: 140px;          /* Vaste breedte */\n            height: 140px;         /* Vaste hoogte - alle foto's even groot */\n            border-radius: 50%;    /* Perfecte cirkel */\n            margin: 0 auto 16px;\n            background: linear-gradient(135deg, var(--primary-pale), var(--primary-bg));\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 3.5rem;\n            color: var(--primary);\n            border: 4px solid var(--primary-pale);\n            overflow: hidden;      /* Alles buiten de cirkel wordt afgesneden */\n            flex-shrink: 0;        /* Zorgt dat de avatar niet kleiner wordt */\n        }\n\n        /* ─── AFBEELDING IN DE AVATAR - ALTIJD CORRECT GESNEDEN ─── */\n        .team-card .avatar img {\n            width: 100%;           /* Vult de volledige breedte van de avatar */\n            height: 100%;          /* Vult de volledige hoogte van de avatar */\n            object-fit: cover;     /* Snijdt de afbeelding bij zonder vervorming */\n            display: block;\n        }\n\n        /* ─── PLACEHOLDER STYLING (zolang er geen foto is) ─── */\n        .team-card .avatar.placeholder {\n            font-size: 3.5rem;\n            color: var(--primary);\n            user-select: none;\n        }\n\n        .team-card h3 {\n            color: var(--primary);\n            font-size: 1.5rem;\n            margin-bottom: 4px;\n        }\n\n        .team-card .role {\n            color: var(--primary-light);\n            font-weight: 600;\n            font-size: 0.95rem;\n            margin-bottom: 10px;\n        }\n\n        .team-card .qualifications {\n            list-style: none;\n            padding: 0;\n            margin: 10px 0 12px;\n        }\n\n        .team-card .qualifications li {\n            font-size: 0.9rem;\n            color: var(--text-muted);\n            padding: 3px 0;\n        }\n\n        .team-card .bio {\n            font-size: 0.95rem;\n            color: var(--text-muted);\n            line-height: 1.7;\n        }\n\n        /* ─── FEATURES GRID 2x2 ─── */\n        .features-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        .feature-card {\n            background: var(--white);\n            padding: 35px 28px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .feature-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .feature-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .feature-card .icon {\n            font-size: 2.8rem;\n            margin-bottom: 14px;\n            display: block;\n        }\n\n        .feature-card h3 {\n            color: var(--primary);\n            margin-bottom: 10px;\n            font-size: 1.4rem;\n        }\n\n        .feature-card p {\n            color: var(--text-muted);\n            font-size: 0.98rem;\n        }\n\n        /* ─── SECTION LIGHT ─── */\n        .section-light {\n            background: var(--primary-bg);\n        }\n\n        .section-light .container {\n            padding: 80px 0;\n        }\n\n        /* ─── CTA SECTION ─── */\n        .cta-block {\n            background: linear-gradient(145deg, var(--primary-bg), var(--primary-pale));\n            border-radius: var(--radius);\n            padding: 80px 60px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            margin: 40px 0 0;\n        }\n\n        .cta-block::before {\n            content: '';\n            position: absolute;\n            top: -120px;\n            right: -120px;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(255,255,255,0.30) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block::after {\n            content: '';\n            position: absolute;\n            bottom: -150px;\n            left: -150px;\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block .cta-inner {\n            position: relative;\n            z-index: 2;\n        }\n\n        .cta-block h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .cta-block p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            max-width: 680px;\n            margin: 0 auto;\n        }\n\n        .cta-block .btn-group {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n        }\n\n        .cta-block .btn-primary {\n            background: var(--primary);\n            color: var(--white);\n        }\n        .cta-block .btn-primary:hover {\n            background: var(--primary-light);\n        }\n\n        .cta-block .btn-secondary {\n            background: var(--white);\n            color: var(--primary);\n            border: 2px solid var(--primary);\n        }\n        .cta-block .btn-secondary:hover {\n            background: var(--primary);\n            color: var(--white);\n        }\n\n        .cta-block .trust-badges {\n            display: flex;\n            justify-content: center;\n            gap: 32px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .cta-block .trust-badges span {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        /* ─── EXTERNE LINK ─── */\n        .external-link {\n            text-align: center;\n            padding: 30px 0 10px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .external-link a {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n        }\n        .external-link a:hover {\n            text-decoration: underline;\n        }\n\n        /* ─── RESPONSIVE ─── */\n        @media (max-width: 1024px) {\n            h1 { font-size: 3rem; }\n            h2 { font-size: 2.2rem; }\n            .grid-2 { grid-template-columns: 1fr; gap: 40px; }\n            .grid-2 .image-wrap { order: -1; }\n            .grid-2 .image-wrap img { height: 320px; }\n            .team-grid { grid-template-columns: 1fr 1fr; }\n            .features-grid { grid-template-columns: 1fr 1fr; }\n        }\n\n        @media (max-width: 768px) {\n            h1 { font-size: 2.4rem; }\n            .hero { min-height: 70vh; padding: 60px 0; }\n            .hero-subtitle { font-size: 1.1rem; }\n            .hero-cta { flex-direction: column; align-items: center; }\n            .btn { width: 100%; max-width: 320px; justify-content: center; }\n            .team-grid { grid-template-columns: 1fr; max-width: 420px; margin-left: auto; margin-right: auto; }\n            .features-grid { grid-template-columns: 1fr; }\n            .cta-block { padding: 50px 24px; }\n            .cta-block .trust-badges { flex-direction: column; align-items: center; gap: 12px; }\n            section { padding: 50px 0; }\n            .section-light .container { padding: 50px 0; }\n            .grid-2 .image-wrap img { height: 240px; }\n            .team-card .avatar { width: 120px; height: 120px; }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.8rem; }\n            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }\n            .team-card { padding: 25px 20px; }\n            .team-card .avatar { width: 100px; height: 100px; font-size: 2.8rem; }\n            .feature-card { padding: 25px 20px; }\n            .cta-block { padding: 40px 18px; }\n        }\n    </style>\n\n\n\n\n    <!-- ═══ HERO ═══ -->\n    <section class=\"hero\">\n        <div class=\"hero-bg\" loading=\"lazy\"></div>\n        <div class=\"hero-pattern\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                Kindvriendelijke praktijk\n            </div>\n            <h1><span>De praktijk</span> van Kids Fysio Capelle</h1>\n            <p class=\"hero-subtitle\">Moderne kinderfysiotherapie in Capelle aan den IJssel. 4 behandelkamers, speelse oefenzaal en een gespecialiseerd team voor uw kind.</p>\n            <div class=\"hero-cta\">\n                <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                <a href=\"/contact/\" class=\"btn btn-outline\">📅 Afspraak maken</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- ═══ MAIN CONTENT ═══ -->\n    <main class=\"container\">\n\n        <!-- ─── SECTIE 1: PRAKTIJK INTRO ─── -->\n        <section>\n            <div class=\"section-intro\">\n                <h2>Onze moderne praktijk in Oostgaarde</h2>\n                <p>Kids Fysio Capelle is gevestigd in de wijk Oostgaarde in Capelle aan den IJssel. In onze praktijk aan De Linie beschikken wij over een moderne, ruime locatie met vier behandelkamers en een grote, speelse oefenzaal voor <strong>kinderfysiotherapie</strong>.</p>\n            </div>\n\n            <div class=\"grid-2\">\n                <div class=\"text-content\">\n                    <h3>Een plek waar kinderen zich thuis voelen</h3>\n                    <p>Deze omgeving is speciaal ingericht zodat kinderen zich direct veilig en op hun gemak voelen bij <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel. Vaak zien we dat spanning voor een medische afspraak al in de eerste minuten verdwijnt. Kinderen stappen spelenderwijs binnen en voelen zich meteen thuis.</p>\n                    <p style=\"margin-top:16px;\">Onze <strong>kinderfysiotherapie</strong> praktijk is ontworpen met oog voor de belevingswereld van kinderen. Kleuren, materialen en indeling zijn allemaal afgestemd op de jonge bezoeker.</p>\n                    <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--primary-bg);border-radius:100px;margin-top:20px;font-weight:600;color:var(--primary);\">\n                        ✓ 4 behandelkamers\n                    </div>\n                </div>\n                <div class=\"image-wrap\">\n                    <img src=\"/images/KidsFysioCapelle-De-praktijk-1.webp\" alt=\"Moderne praktijkruimte voor kinderfysiotherapie bij Kids Fysio Capelle in Capelle aan den IJssel\" loading=\"lazy\">\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 2: TEAM (2x2 grid - professioneel en ruim) ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Ons gespecialiseerde team</h2>\n                <p>Maak kennis met onze gepassioneerde kinderfysiotherapeuten die klaar staan voor uw kind in Capelle aan den IJssel.</p>\n            </div>\n\n            <div class=\"team-grid\">\n\n                <!-- ═══ MELISSA ═══ -->\n                <div class=\"team-card\">\n                    <div class=\"avatar\">\n                        <!-- ════════════════════════════════════════════════════ -->\n                        <!-- VERVANG DE PLACEHOLDER DOOR DE ECHTE FOTO:            -->\n                        <!-- <img src=\"/images/mellisa.jpg\" alt=\"Mellisa - Kinderfysiotherapeut bij Kids Fysio Capelle\"> -->\n                        <!-- ════════════════════════════════════════════════════ -->\n                        👤\n                    </div>\n                    <h3>Mellisa</h3>\n                    <div class=\"role\">Praktijkeigenaar & Kinderfysiotherapeut</div>\n                    <ul class=\"qualifications\">\n                        <li>Kinderfysiotherapeut MSc.</li>\n                        <li>SI-therapeut</li>\n                        <li>BIG: 89919206204</li>\n                    </ul>\n                    <div class=\"bio\">\n                        <p>Afgestudeerd in 2014 en gespecialiseerd in <strong>kinderfysiotherapie</strong> sinds 2016. Mijn passie is kinderen het plezier van bewegen te laten ervaren.</p>\n                    </div>\n                </div>\n\n                <!-- ═══ RENATE ═══ -->\n                <div class=\"team-card\">\n                    <div class=\"avatar\">\n                        <!-- ════════════════════════════════════════════════════ -->\n                        <!-- VERVANG DE PLACEHOLDER DOOR DE ECHTE FOTO:            -->\n                        <!-- <img src=\"/images/renate.jpg\" alt=\"Renate - Kinderfysiotherapeut bij Kids Fysio Capelle\"> -->\n                        <!-- ════════════════════════════════════════════════════ -->\n                        👤\n                    </div>\n                    <h3>Renate</h3>\n                    <div class=\"role\">Kinderfysiotherapeut & SI-therapeut</div>\n                    <ul class=\"qualifications\">\n                        <li>Kinderfysiotherapeut MSc.</li>\n                        <li>SI-therapeut</li>\n                        <li>BIG: 39921638804</li>\n                    </ul>\n                    <div class=\"bio\">\n                        <p>Ervaren in <strong>kinderfysiotherapie</strong> met achtergrond in pedagogiek. Gespecialiseerd in sensorische informatieverwerking. Werkdagen: di, do en vr.</p>\n                    </div>\n                </div>\n\n                <!-- ═══ MYRTHE ═══ -->\n                <div class=\"team-card\">\n                    <div class=\"avatar\">\n                        <!-- ════════════════════════════════════════════════════ -->\n                        <!-- VERVANG DE PLACEHOLDER DOOR DE ECHTE FOTO:            -->\n                        <!-- <img src=\"/images/myrthe.jpg\" alt=\"Myrthe - Kinderfysiotherapeut bij Kids Fysio Capelle\"> -->\n                        <!-- ════════════════════════════════════════════════════ -->\n                        👤\n                    </div>\n                    <h3>Myrthe</h3>\n                    <div class=\"role\">Kinderfysiotherapeut</div>\n                    <ul class=\"qualifications\">\n                        <li>Kinderfysiotherapeut MSc.</li>\n                        <li>BIG: 89927748804</li>\n                    </ul>\n                    <div class=\"bio\">\n                        <p>Recent afgestudeerd in <strong>kinderfysiotherapie</strong> met veel enthousiasme. Werkzaam op basisscholen, Citykids en in onze praktijk.</p>\n                    </div>\n                </div>\n\n                <!-- ═══ JOYCE ═══ -->\n                <div class=\"team-card\">\n                    <div class=\"avatar\">\n                        <!-- ════════════════════════════════════════════════════ -->\n                        <!-- VERVANG DE PLACEHOLDER DOOR DE ECHTE FOTO:            -->\n                        <!-- <img src=\"/images/joyce.jpg\" alt=\"Joyce - Teamlid bij Kids Fysio Capelle\"> -->\n                        <!-- ════════════════════════════════════════════════════ -->\n                        👤\n                    </div>\n                    <h3>Joyce</h3>\n                    <div class=\"role\">Teamlid</div>\n                    <ul class=\"qualifications\">\n                        <li>Informatie volgt binnenkort</li>\n                    </ul>\n                    <div class=\"bio\">\n                        <p>Binnenkort meer informatie over Joyce! Ze versterkt ons team in <strong>kinderfysiotherapie</strong>.</p>\n                    </div>\n                </div>\n\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 3: BEWEGEN MET PLEZIER ─── -->\n        <section style=\"padding-top:20px;\" class=\"section-light\">\n            <div class=\"container\">\n                <div class=\"grid-2\">\n                    <div class=\"image-wrap\">\n                        <img src=\"/images/KidsFysioCapelle-behandeling.webp\" alt=\"Kinderfysiotherapie behandeling bij Kids Fysio Capelle in Capelle aan den IJssel\" loading=\"lazy\">\n                    </div>\n                    <div class=\"text-content\">\n                        <h2>Bewegen met plezier</h2>\n                        <p>Bij Kids Fysio Capelle draait alles om bewegen met plezier. Ieder kind is anders, daarom combineren wij onze professionele expertise met creativiteit, passend oefenmateriaal en persoonlijke aandacht in onze <strong>kinderfysiotherapie</strong>.</p>\n                        <p style=\"margin-top:16px;\">We investeren bewust in het opbouwen van een vertrouwensband met uw kind, zodat hij of zij gemotiveerd raakt om actief te oefenen. Met onze uitgebreide materialen en uitdagende oefenruimte creëren wij voor elke leeftijd een omgeving die precies aansluit bij het doel, ontwikkelingsniveau en behandeltraject van uw kind binnen de <strong>kinderfysiotherapie</strong>.</p>\n                        <p style=\"margin-top:16px;\">Zo maken we samen stap voor stap vooruitgang met plezier, veiligheid en vertrouwen voorop.</p>\n                        <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--primary-bg);border-radius:100px;margin-top:20px;font-weight:600;color:var(--primary);\">\n                            ✓ Plezier in bewegen\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 4: FEATURES ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Wat onze praktijk bijzonder maakt</h2>\n                <p>Ontdek waarom ouders voor Kids Fysio Capelle kiezen voor <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel.</p>\n            </div>\n\n            <div class=\"features-grid\">\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🏠</span>\n                    <h3>Moderne locatie</h3>\n                    <p>Vier behandelkamers en een grote, speelse oefenzaal in de wijk Oostgaarde, Capelle aan den IJssel voor optimale <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🧸</span>\n                    <h3>Kindvriendelijke omgeving</h3>\n                    <p>Speciaal ingericht zodat kinderen zich direct veilig en op hun gemak voelen tijdens <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🎯</span>\n                    <h3>Persoonlijke aanpak</h3>\n                    <p>Ieder kind is uniek, daarom werken we met persoonlijke behandelplannen binnen de <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🤝</span>\n                    <h3>Vertrouwensband</h3>\n                    <p>We investeren in een goede relatie met uw kind voor een optimale <strong>kinderfysiotherapie</strong> behandeling.</p>\n                </div>\n            </div>\n        \n\n        <!-- ─── CTA ─── -->\n        <section style=\"padding:40px 0 80px;\">\n            <div class=\"cta-block\">\n                <div class=\"cta-inner\">\n                    <h2>Wilt u onze praktijk bezoeken?</h2>\n                    <p>Neem contact op voor een afspraak of meer informatie over onze <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel. We heten u graag welkom!</p>\n                    <div class=\"btn-group\">\n                        <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                        <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"btn btn-secondary\">✉️ Stuur een e-mail</a>\n                        <a href=\"/contact/\" class=\"btn btn-secondary\">📅 Afspraak maken</a>\n                    </div>\n                    <div class=\"trust-badges\">\n                        <span>✓ Vergoed door alle zorgverzekeraars</span>\n                        <span>✓ Geen wachtlijst</span>\n                        <span>✓ Gespecialiseerde kinderfysiotherapeuten</span>\n                        <span>✓ Kindvriendelijke omgeving</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- ─── SCRIPT ─── -->", "scripts": ["document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.team-card, .feature-card');\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.style.opacity = '1';\n                        entry.target.style.transform = 'translateY(0)';\n                    }\n                });\n            }, { threshold: 0.1 });\n\n            elements.forEach(el => {\n                el.style.opacity = '0';\n                el.style.transform = 'translateY(24px)';\n                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n                observer.observe(el);\n            });\n        });"]}