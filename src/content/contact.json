{"html": "<style>\n        /* ─── PREMIUM ROOT VARIABLES ─── */\n        :root {\n            --primary: #1a5c47;\n            --primary-light: #2a7d62;\n            --primary-pale: #b5dfcb;\n            --primary-bg: #f0f9f5;\n            --white: #ffffff;\n            --text-dark: #1e2b2a;\n            --text-muted: #4a5f5c;\n            --shadow-sm: 0 4px 20px rgba(0,0,0,0.06);\n            --shadow-lg: 0 30px 80px rgba(0,0,0,0.12);\n            --radius: 20px;\n            --radius-sm: 12px;\n            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n        }\n\n        /* ─── RESET & BASE ─── */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Open Sans', sans-serif;\n            background: var(--white);\n            color: var(--text-dark);\n            line-height: 1.8;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 24px;\n        }\n\n        /* ─── TYPOGRAPHY ─── */\n        h1, h2, h3, h4 {\n            font-family: 'Nunito', sans-serif;\n            font-weight: 800;\n            line-height: 1.25;\n        }\n\n        h1 { font-size: 3.8rem; letter-spacing: -0.02em; }\n        h2 { font-size: 2.6rem; letter-spacing: -0.01em; }\n        h3 { font-size: 1.8rem; }\n        h4 { font-size: 1.3rem; }\n\n        /* ─── HERO SECTION ─── */\n        .hero {\n            position: relative;\n            min-height: 70vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: linear-gradient(165deg, #0d2f26 0%, #1a5c47 40%, #2a7d62 100%);\n            overflow: hidden;\n            isolation: isolate;\n        }\n\n        /* Achtergrondfoto met lazy loading */\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            background: url('/images/Kids-Fysio-Capelle-wachtkamer.webp') center/cover no-repeat;\n            opacity: 0.15;\n            transform: scale(1.05);\n            will-change: transform;\n            transition: transform 8s ease;\n        }\n\n        .hero:hover .hero-bg {\n            transform: scale(1.1);\n        }\n\n        .hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: \n                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(181, 223, 203, 0.12) 0%, transparent 70%),\n                radial-gradient(ellipse 60% 50% at 80% 20%, rgba(181, 223, 203, 0.06) 0%, transparent 60%);\n            z-index: 1;\n        }\n\n        .hero::after {\n            content: '';\n            position: absolute;\n            top: -30%;\n            right: -10%;\n            width: 600px;\n            height: 600px;\n            background: radial-gradient(circle, rgba(181, 223, 203, 0.05) 0%, transparent 70%);\n            border-radius: 50%;\n            z-index: 1;\n        }\n\n        .hero-pattern {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            opacity: 0.03;\n            background-image: \n                radial-gradient(circle at 20% 50%, var(--white) 1px, transparent 1px),\n                radial-gradient(circle at 80% 20%, var(--white) 1px, transparent 1px);\n            background-size: 60px 60px;\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 2;\n            max-width: 900px;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 10px 28px;\n            background: rgba(255,255,255,0.10);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255,255,255,0.15);\n            border-radius: 100px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            color: rgba(255,255,255,0.95);\n            letter-spacing: 0.3px;\n            margin-bottom: 32px;\n            animation: fadeDown 0.8s ease both;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            fill: currentColor;\n        }\n\n        .hero h1 {\n            color: var(--white);\n            margin-bottom: 20px;\n            animation: fadeUp 0.8s ease 0.15s both;\n        }\n\n        .hero h1 span {\n            background: linear-gradient(135deg, var(--primary-pale), #e8f5ef);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.35rem;\n            color: rgba(255,255,255,0.85);\n            max-width: 700px;\n            margin: 0 auto;\n            font-weight: 400;\n            line-height: 1.6;\n            animation: fadeUp 0.8s ease 0.3s both;\n        }\n\n        .hero-cta {\n            margin-top: 40px;\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            animation: fadeUp 0.8s ease 0.45s both;\n        }\n\n        .btn {\n            padding: 16px 38px;\n            border-radius: 100px;\n            font-family: 'Nunito', sans-serif;\n            font-weight: 700;\n            font-size: 1.05rem;\n            text-decoration: none;\n            transition: var(--transition);\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--white);\n            color: var(--primary);\n            box-shadow: 0 8px 32px rgba(0,0,0,0.20);\n        }\n        .btn-primary:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 16px 48px rgba(0,0,0,0.30);\n        }\n\n        .btn-outline {\n            background: transparent;\n            color: var(--white);\n            border: 2px solid rgba(255,255,255,0.30);\n        }\n        .btn-outline:hover {\n            background: rgba(255,255,255,0.10);\n            border-color: rgba(255,255,255,0.60);\n            transform: translateY(-3px);\n        }\n\n        /* ─── ANIMATIONS ─── */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        @keyframes fadeDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ─── SECTION STYLING ─── */\n        section {\n            padding: 80px 0;\n        }\n\n        .section-intro {\n            text-align: center;\n            max-width: 780px;\n            margin: 0 auto 60px;\n        }\n\n        .section-intro h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .section-intro h2::after {\n            content: '';\n            display: block;\n            width: 70px;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            margin: 18px auto 0;\n            border-radius: 4px;\n        }\n\n        .section-intro p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            margin-top: 20px;\n        }\n\n        /* ─── CONTACT GRID 2x2 ─── */\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        .contact-card {\n            background: var(--white);\n            padding: 35px 30px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .contact-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .contact-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .contact-card .icon {\n            font-size: 2.8rem;\n            margin-bottom: 16px;\n            display: block;\n        }\n\n        .contact-card h3 {\n            color: var(--primary);\n            margin-bottom: 12px;\n            font-size: 1.4rem;\n        }\n\n        .contact-card p {\n            color: var(--text-muted);\n            font-size: 0.98rem;\n        }\n\n        .contact-card .contact-link {\n            display: inline-block;\n            margin-top: 8px;\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 700;\n            font-size: 1.1rem;\n            transition: var(--transition);\n        }\n\n        .contact-card .contact-link:hover {\n            color: var(--primary-light);\n        }\n\n        /* ─── LOCATION & HOURS GRID ─── */\n        .location-hours-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        .info-card {\n            background: var(--white);\n            padding: 35px 30px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            text-align: center;\n        }\n\n        .info-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .info-card .icon {\n            font-size: 2.8rem;\n            margin-bottom: 16px;\n            display: block;\n        }\n\n        .info-card h3 {\n            color: var(--primary);\n            margin-bottom: 12px;\n            font-size: 1.4rem;\n        }\n\n        .info-card .address {\n            color: var(--text-dark);\n            font-weight: 600;\n        }\n\n        .info-card .address-detail {\n            color: var(--text-muted);\n            font-size: 0.98rem;\n        }\n\n        /* ─── OPENINGSTIJDEN ─── */\n        .opening-hours {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 8px 20px;\n            margin-top: 16px;\n            text-align: left;\n            max-width: 320px;\n            margin-left: auto;\n            margin-right: auto;\n        }\n\n        .opening-hours .day {\n            font-weight: 600;\n            color: var(--text-dark);\n        }\n\n        .opening-hours .time {\n            color: var(--text-muted);\n            text-align: right;\n        }\n\n        /* ─── PRACTICE INFO (kenmerken) ─── */\n        .practice-features {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 20px;\n            margin-top: 40px;\n        }\n\n        .feature-item {\n            background: var(--primary-bg);\n            padding: 20px 16px;\n            border-radius: var(--radius-sm);\n            text-align: center;\n            transition: var(--transition);\n        }\n\n        .feature-item:hover {\n            background: var(--primary-pale);\n            transform: translateY(-4px);\n        }\n\n        .feature-item .icon {\n            font-size: 2rem;\n            display: block;\n            margin-bottom: 8px;\n        }\n\n        .feature-item strong {\n            display: block;\n            color: var(--primary);\n            font-size: 0.95rem;\n        }\n\n        .feature-item p {\n            font-size: 0.85rem;\n            color: var(--text-muted);\n            margin-top: 4px;\n        }\n\n        /* ─── MAP ─── */\n        .map-container {\n            border-radius: var(--radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-sm);\n            margin-top: 40px;\n        }\n\n        .map-container iframe {\n            width: 100%;\n            height: 380px;\n            border: none;\n            display: block;\n        }\n\n        /* ─── WP FORM CONTAINER ─── */\n        .wpforms-container {\n            background: var(--white);\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            padding: 40px;\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            margin-top: 20px;\n        }\n\n        .wpforms-container .form-title {\n            text-align: center;\n            margin-bottom: 30px;\n        }\n\n        .wpforms-container .form-title h2 {\n            color: var(--primary);\n            margin-top: 0;\n        }\n\n        .wpforms-container .form-title h2::after {\n            margin: 12px auto 0;\n        }\n\n        .wpforms-container .form-title p {\n            color: var(--text-muted);\n            font-size: 1.05rem;\n        }\n\n        /* ─── CTA SECTION ─── */\n        .cta-block {\n            background: linear-gradient(145deg, var(--primary-bg), var(--primary-pale));\n            border-radius: var(--radius);\n            padding: 60px 40px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            margin: 40px 0 0;\n        }\n\n        .cta-block::before {\n            content: '';\n            position: absolute;\n            top: -120px;\n            right: -120px;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(255,255,255,0.30) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block::after {\n            content: '';\n            position: absolute;\n            bottom: -150px;\n            left: -150px;\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block .cta-inner {\n            position: relative;\n            z-index: 2;\n        }\n\n        .cta-block h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .cta-block p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            max-width: 680px;\n            margin: 0 auto;\n        }\n\n        .cta-block .btn-group {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n        }\n\n        .cta-block .btn-primary {\n            background: var(--primary);\n            color: var(--white);\n        }\n        .cta-block .btn-primary:hover {\n            background: var(--primary-light);\n        }\n\n        .cta-block .btn-secondary {\n            background: var(--white);\n            color: var(--primary);\n            border: 2px solid var(--primary);\n        }\n        .cta-block .btn-secondary:hover {\n            background: var(--primary);\n            color: var(--white);\n        }\n\n        .cta-block .trust-badges {\n            display: flex;\n            justify-content: center;\n            gap: 32px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .cta-block .trust-badges span {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        /* ─── EXTERNE LINK ─── */\n        .external-link {\n            text-align: center;\n            padding: 30px 0 10px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .external-link a {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n        }\n        .external-link a:hover {\n            text-decoration: underline;\n        }\n\n        /* ─── RESPONSIVE ─── */\n        @media (max-width: 1024px) {\n            h1 { font-size: 3rem; }\n            h2 { font-size: 2.2rem; }\n            .contact-grid { grid-template-columns: 1fr 1fr; }\n            .practice-features { grid-template-columns: repeat(2, 1fr); }\n            .location-hours-grid { grid-template-columns: 1fr 1fr; }\n        }\n\n        @media (max-width: 768px) {\n            h1 { font-size: 2.4rem; }\n            .hero { min-height: 70vh; padding: 60px 0; }\n            .hero-subtitle { font-size: 1.1rem; }\n            .hero-cta { flex-direction: column; align-items: center; }\n            .btn { width: 100%; max-width: 320px; justify-content: center; }\n            .contact-grid { grid-template-columns: 1fr; }\n            .location-hours-grid { grid-template-columns: 1fr; }\n            .practice-features { grid-template-columns: 1fr 1fr; }\n            .wpforms-container { padding: 25px 20px; }\n            .cta-block { padding: 40px 24px; }\n            .cta-block .trust-badges { flex-direction: column; align-items: center; gap: 12px; }\n            section { padding: 50px 0; }\n            .map-container iframe { height: 280px; }\n            .opening-hours { grid-template-columns: 1fr 1fr; gap: 6px 16px; }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.8rem; }\n            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }\n            .contact-card { padding: 25px 20px; }\n            .info-card { padding: 25px 20px; }\n            .practice-features { grid-template-columns: 1fr; }\n            .wpforms-container { padding: 20px 15px; }\n            .cta-block { padding: 35px 18px; }\n            .map-container iframe { height: 220px; }\n            .opening-hours { grid-template-columns: 1fr 1fr; gap: 4px 12px; font-size: 0.95rem; }\n        }\n    </style>\n\n\n\n\n    <!-- ═══ HERO ═══ -->\n    <section class=\"hero\">\n        <div class=\"hero-bg\" loading=\"lazy\"></div>\n        <div class=\"hero-pattern\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                Neem vrijblijvend contact op\n            </div>\n            <h1><span>Neem contact</span> met ons op</h1>\n            <p class=\"hero-subtitle\">Kinderfysiotherapie in Capelle aan den IJssel. Uw kind is in goede handen. Bel voor advies of maak direct een afspraak bij Kids Fysio Capelle.</p>\n            <div class=\"hero-cta\">\n                <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                <a href=\"#formulier\" class=\"btn btn-outline\">📝 Stuur een bericht</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- ═══ MAIN CONTENT ═══ -->\n    <main class=\"container\">\n\n        <!-- ─── SECTIE 1: INTRO ─── -->\n        <section>\n            <div class=\"section-intro\">\n                <h2>Hoe kunnen we u helpen?</h2>\n                <p>Heeft u vragen over de behandeling van uw kind of wilt u direct een afspraak maken voor <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel? We staan klaar om u te helpen. Bereik ons telefonisch, per e-mail of kom langs in onze kindvriendelijke praktijk.</p>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 2: CONTACTGEGEVENS (2x2 grid) ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-card\">\n                    <span class=\"icon\">📞</span>\n                    <h3>Telefonisch contact</h3>\n                    <p>Bereik ons tijdens kantooruren voor vragen of het maken van een afspraak voor <strong>kinderfysiotherapie</strong>.</p>\n                    <a href=\"tel:0103032575\" class=\"contact-link\">010-303 2575</a>\n                </div>\n                <div class=\"contact-card\">\n                    <span class=\"icon\">✉️</span>\n                    <h3>E-mail</h3>\n                    <p>Stuur ons een e-mail voor vragen over <strong>kinderfysiotherapie</strong> of om een afspraak te maken. Wij reageren binnen 24 uur.</p>\n                    <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"contact-link\">info@kidsfysiocapelle.nl</a>\n                </div>\n                <div class=\"contact-card\">\n                    <span class=\"icon\">📍</span>\n                    <h3>Bezoek onze praktijk</h3>\n                    <p>Kids Fysio Capelle<br>De Linie 1D<br>2905 AX Capelle aan den IJssel</p>\n                    <p style=\"margin-top:8px; font-size:0.9rem; color:var(--text-muted);\">Gratis parkeren en goed bereikbaar</p>\n                </div>\n                <div class=\"contact-card\">\n                    <span class=\"icon\">🕐</span>\n                    <h3>Openingstijden</h3>\n                    <div class=\"opening-hours\">\n                        <span class=\"day\">Ma t/m Vrij</span>\n                        <span class=\"time\">08:30 - 18:00</span>\n                        <span class=\"day\">Avondspreekuur</span>\n                        <span class=\"time\">Op afspraak</span>\n                        <span class=\"day\">Zaterdag</span>\n                        <span class=\"time\">Gesloten</span>\n                        <span class=\"day\">Zondag</span>\n                        <span class=\"time\">Gesloten</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 3: PRAKTIJKINFORMATIE ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Onze kindvriendelijke praktijk</h2>\n                <p>Bij Kids Fysio Capelle staat uw kind centraal. Ontdek waarom ouders voor ons kiezen voor <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel.</p>\n            </div>\n\n            <div class=\"practice-features\">\n                <div class=\"feature-item\">\n                    <span class=\"icon\">🧸</span>\n                    <strong>Kindvriendelijk</strong>\n                    <p>Wachtkamer en behandelruimtes speciaal ingericht voor kinderen</p>\n                </div>\n                <div class=\"feature-item\">\n                    <span class=\"icon\">🅿️</span>\n                    <strong>Gratis parkeren</strong>\n                    <p>Ruime parkeergelegenheid direct voor de deur</p>\n                </div>\n                <div class=\"feature-item\">\n                    <span class=\"icon\">🚌</span>\n                    <strong>Goed bereikbaar</strong>\n                    <p>Met zowel eigen vervoer als openbaar vervoer</p>\n                </div>\n                <div class=\"feature-item\">\n                    <span class=\"icon\">🏅</span>\n                    <strong>BIG-geregistreerd</strong>\n                    <p>Alle therapeuten zijn BIG-geregistreerd en gespecialiseerd</p>\n                </div>\n            </div>\n\n            <!-- Map -->\n            <div class=\"map-container\">\n                <iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2459.9881620701376!2d4.594800475368277!3d51.93416947943885!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c5d3326fd6c103%3A0x77c5c6553ea4dec7!2sKids%20Fysio%20Capelle!5e0!3m2!1snl!2snl!4v1763930040346!5m2!1snl!2snl\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" title=\"Kaart van Kids Fysio Capelle locatie\"></iframe>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 4: CONTACTFORMULIER ─── -->\n        <section id=\"formulier\" style=\"padding-top:20px;\">\n            <div class=\"wpforms-container\">\n                <div class=\"form-title\">\n                    <h2>Stuur ons een bericht</h2>\n                    <p>Vul onderstaand formulier in en we nemen zo snel mogelijk contact met u op over <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel.</p>\n                </div>\n                <div id=\"kfc-contact-form\"></div>\n            </div>\n        \n\n        <!-- ─── CTA ─── -->\n        <section style=\"padding:40px 0 80px;\">\n            <div class=\"cta-block\">\n                <div class=\"cta-inner\">\n                    <h2>Heeft u vragen over kinderfysiotherapie?</h2>\n                    <p>Onze gespecialiseerde kinderfysiotherapeuten in Capelle aan den IJssel staan voor u klaar. Neem vrijblijvend contact op voor advies of het maken van een afspraak.</p>\n                    <div class=\"btn-group\">\n                        <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                        <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"btn btn-secondary\">✉️ Stuur een e-mail</a>\n                        <a href=\"/contact/\" class=\"btn btn-secondary\">📅 Afspraak maken</a>\n                    </div>\n                    <div class=\"trust-badges\">\n                        <span>✓ Vergoed door alle zorgverzekeraars</span>\n                        <span>✓ Geen wachtlijst</span>\n                        <span>✓ Gespecialiseerde kinderfysiotherapeuten</span>\n                        <span>✓ Kindvriendelijke omgeving</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- ─── SCRIPT ─── -->", "scripts": ["document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.contact-card, .info-card, .feature-item');\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.style.opacity = '1';\n                        entry.target.style.transform = 'translateY(0)';\n                    }\n                });\n            }, { threshold: 0.1 });\n\n            elements.forEach(el => {\n                el.style.opacity = '0';\n                el.style.transform = 'translateY(24px)';\n                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n                observer.observe(el);\n            });\n        });"]}