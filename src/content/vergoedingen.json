{"html": "<style>\n        /* ─── PREMIUM ROOT VARIABLES ─── */\n        :root {\n            --primary: #1a5c47;\n            --primary-light: #2a7d62;\n            --primary-pale: #b5dfcb;\n            --primary-bg: #f0f9f5;\n            --white: #ffffff;\n            --text-dark: #1e2b2a;\n            --text-muted: #4a5f5c;\n            --shadow-sm: 0 4px 20px rgba(0,0,0,0.06);\n            --shadow-lg: 0 30px 80px rgba(0,0,0,0.12);\n            --radius: 20px;\n            --radius-sm: 12px;\n            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n        }\n\n        /* ─── RESET & BASE ─── */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Open Sans', sans-serif;\n            background: var(--white);\n            color: var(--text-dark);\n            line-height: 1.8;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 24px;\n        }\n\n        /* ─── TYPOGRAPHY ─── */\n        h1, h2, h3, h4 {\n            font-family: 'Nunito', sans-serif;\n            font-weight: 800;\n            line-height: 1.25;\n        }\n\n        h1 { font-size: 3.8rem; letter-spacing: -0.02em; }\n        h2 { font-size: 2.6rem; letter-spacing: -0.01em; }\n        h3 { font-size: 1.8rem; }\n        h4 { font-size: 1.3rem; }\n\n        /* ─── HERO SECTION ─── */\n        .hero {\n            position: relative;\n            min-height: 70vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: linear-gradient(165deg, #0d2f26 0%, #1a5c47 40%, #2a7d62 100%);\n            overflow: hidden;\n            isolation: isolate;\n        }\n\n        .hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: \n                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(181, 223, 203, 0.12) 0%, transparent 70%),\n                radial-gradient(ellipse 60% 50% at 80% 20%, rgba(181, 223, 203, 0.06) 0%, transparent 60%);\n            z-index: 1;\n        }\n\n        .hero::after {\n            content: '';\n            position: absolute;\n            top: -30%;\n            right: -10%;\n            width: 600px;\n            height: 600px;\n            background: radial-gradient(circle, rgba(181, 223, 203, 0.05) 0%, transparent 70%);\n            border-radius: 50%;\n            z-index: 1;\n        }\n\n        .hero-pattern {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            opacity: 0.03;\n            background-image: \n                radial-gradient(circle at 20% 50%, var(--white) 1px, transparent 1px),\n                radial-gradient(circle at 80% 20%, var(--white) 1px, transparent 1px);\n            background-size: 60px 60px;\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 2;\n            max-width: 900px;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 10px 28px;\n            background: rgba(255,255,255,0.10);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255,255,255,0.15);\n            border-radius: 100px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            color: rgba(255,255,255,0.95);\n            letter-spacing: 0.3px;\n            margin-bottom: 32px;\n            animation: fadeDown 0.8s ease both;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            fill: currentColor;\n        }\n\n        .hero h1 {\n            color: var(--white);\n            margin-bottom: 20px;\n            animation: fadeUp 0.8s ease 0.15s both;\n        }\n\n        .hero h1 span {\n            background: linear-gradient(135deg, var(--primary-pale), #e8f5ef);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.35rem;\n            color: rgba(255,255,255,0.85);\n            max-width: 700px;\n            margin: 0 auto;\n            font-weight: 400;\n            line-height: 1.6;\n            animation: fadeUp 0.8s ease 0.3s both;\n        }\n\n        .hero-cta {\n            margin-top: 40px;\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            animation: fadeUp 0.8s ease 0.45s both;\n        }\n\n        .btn {\n            padding: 16px 38px;\n            border-radius: 100px;\n            font-family: 'Nunito', sans-serif;\n            font-weight: 700;\n            font-size: 1.05rem;\n            text-decoration: none;\n            transition: var(--transition);\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--white);\n            color: var(--primary);\n            box-shadow: 0 8px 32px rgba(0,0,0,0.20);\n        }\n        .btn-primary:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 16px 48px rgba(0,0,0,0.30);\n        }\n\n        .btn-outline {\n            background: transparent;\n            color: var(--white);\n            border: 2px solid rgba(255,255,255,0.30);\n        }\n        .btn-outline:hover {\n            background: rgba(255,255,255,0.10);\n            border-color: rgba(255,255,255,0.60);\n            transform: translateY(-3px);\n        }\n\n        /* ─── ANIMATIONS ─── */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        @keyframes fadeDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ─── SECTION STYLING ─── */\n        section {\n            padding: 80px 0;\n        }\n\n        .section-intro {\n            text-align: center;\n            max-width: 780px;\n            margin: 0 auto 60px;\n        }\n\n        .section-intro h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .section-intro h2::after {\n            content: '';\n            display: block;\n            width: 70px;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            margin: 18px auto 0;\n            border-radius: 4px;\n        }\n\n        .section-intro p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            margin-top: 20px;\n        }\n\n        /* ─── CARDS GRID 3x ─── */\n        .cards-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        .premium-card {\n            background: var(--white);\n            padding: 35px 30px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .premium-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .premium-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .premium-card .icon {\n            font-size: 2.8rem;\n            margin-bottom: 16px;\n            display: block;\n        }\n\n        .premium-card h3 {\n            color: var(--primary);\n            margin-bottom: 12px;\n            font-size: 1.4rem;\n        }\n\n        .premium-card p {\n            color: var(--text-muted);\n            font-size: 0.98rem;\n        }\n\n        /* ─── PRICING SECTION ─── */\n        .pricing-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 40px;\n            margin-top: 20px;\n        }\n\n        .pricing-card {\n            background: var(--white);\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            overflow: hidden;\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n        }\n\n        .pricing-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .pricing-header {\n            background: linear-gradient(135deg, var(--primary), var(--primary-light));\n            color: var(--white);\n            padding: 20px 25px;\n            text-align: center;\n        }\n\n        .pricing-header h3 {\n            color: var(--white);\n            margin: 0;\n            font-size: 1.4rem;\n        }\n\n        .pricing-body {\n            padding: 20px 25px 25px;\n        }\n\n        .price-item {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 14px 0;\n            border-bottom: 1px solid var(--primary-bg);\n            transition: var(--transition);\n        }\n\n        .price-item:hover {\n            background: var(--primary-bg);\n            margin: 0 -10px;\n            padding: 14px 10px;\n            border-radius: var(--radius-sm);\n        }\n\n        .price-item:last-child {\n            border-bottom: none;\n        }\n\n        .service-name {\n            font-weight: 500;\n            color: var(--text-dark);\n        }\n\n        .service-price {\n            font-weight: 700;\n            color: var(--primary);\n            font-size: 1.1rem;\n        }\n\n        /* ─── CTA SECTION ─── */\n        .cta-block {\n            background: linear-gradient(145deg, var(--primary-bg), var(--primary-pale));\n            border-radius: var(--radius);\n            padding: 80px 60px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            margin: 40px 0 0;\n        }\n\n        .cta-block::before {\n            content: '';\n            position: absolute;\n            top: -120px;\n            right: -120px;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(255,255,255,0.30) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block::after {\n            content: '';\n            position: absolute;\n            bottom: -150px;\n            left: -150px;\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block .cta-inner {\n            position: relative;\n            z-index: 2;\n        }\n\n        .cta-block h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .cta-block p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            max-width: 680px;\n            margin: 0 auto;\n        }\n\n        .cta-block .btn-group {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n        }\n\n        .cta-block .btn-primary {\n            background: var(--primary);\n            color: var(--white);\n        }\n        .cta-block .btn-primary:hover {\n            background: var(--primary-light);\n        }\n\n        .cta-block .btn-secondary {\n            background: var(--white);\n            color: var(--primary);\n            border: 2px solid var(--primary);\n        }\n        .cta-block .btn-secondary:hover {\n            background: var(--primary);\n            color: var(--white);\n        }\n\n        .cta-block .trust-badges {\n            display: flex;\n            justify-content: center;\n            gap: 32px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .cta-block .trust-badges span {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        /* ─── EXTERNE LINK ─── */\n        .external-link {\n            text-align: center;\n            padding: 30px 0 10px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .external-link a {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n        }\n        .external-link a:hover {\n            text-decoration: underline;\n        }\n\n        /* ─── RESPONSIVE ─── */\n        @media (max-width: 1024px) {\n            h1 { font-size: 3rem; }\n            h2 { font-size: 2.2rem; }\n            .cards-grid { grid-template-columns: 1fr 1fr; }\n            .pricing-grid { grid-template-columns: 1fr; }\n        }\n\n        @media (max-width: 768px) {\n            h1 { font-size: 2.4rem; }\n            .hero { min-height: 70vh; padding: 60px 0; }\n            .hero-subtitle { font-size: 1.1rem; }\n            .hero-cta { flex-direction: column; align-items: center; }\n            .btn { width: 100%; max-width: 320px; justify-content: center; }\n            .cards-grid { grid-template-columns: 1fr; }\n            .cta-block { padding: 50px 24px; }\n            .cta-block .trust-badges { flex-direction: column; align-items: center; gap: 12px; }\n            section { padding: 50px 0; }\n            .pricing-grid { grid-template-columns: 1fr; }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.8rem; }\n            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }\n            .premium-card { padding: 25px 20px; }\n            .pricing-body { padding: 15px 18px 20px; }\n            .cta-block { padding: 40px 20px; }\n        }\n    </style>\n\n\n\n\n    <!-- ═══ HERO ═══ -->\n    <section class=\"hero\">\n        <div class=\"hero-pattern\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                Volledig vergoed vanuit basisverzekering\n            </div>\n            <h1><span>Vergoedingen</span> & Tarieven</h1>\n            <p class=\"hero-subtitle\">Heldere informatie over vergoedingen vanuit de zorgverzekering en onze tarieven. Geen verrassingen, wel optimale zorg voor uw kind in Capelle aan den IJssel.</p>\n            <div class=\"hero-cta\">\n                <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                <a href=\"/contact/\" class=\"btn btn-outline\">📅 Afspraak maken</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- ═══ MAIN CONTENT ═══ -->\n    <main class=\"container\">\n\n        <!-- ─── SECTIE 1: INTRO ─── -->\n        <section>\n            <div class=\"section-intro\">\n                <h2>Vergoedingen voor kinderfysiotherapie</h2>\n                <p>Bij Kids Fysio Capelle geloven we in transparantie. Daarom vindt u hier een volledig overzicht van vergoedingen en tarieven voor <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel. De meeste behandelingen worden volledig vergoed door uw zorgverzekeraar.</p>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 2: VERGOEDINGEN CARDS ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"cards-grid\">\n                <div class=\"premium-card\">\n                    <span class=\"icon\">🏥</span>\n                    <h3>18 Behandelingen vergoed</h3>\n                    <p><strong>Kinderfysiotherapie</strong> wordt 18 keer per kalenderjaar vanuit de basisverzekering vergoed. Als meer behandelingen nodig zijn, worden deze vergoed vanuit de aanvullende verzekering.</p>\n                </div>\n                <div class=\"premium-card\">\n                    <span class=\"icon\">📋</span>\n                    <h3>Contracten met alle verzekeraars</h3>\n                    <p>We hebben met alle zorgverzekeraars contracten afgesloten voor <strong>kinderfysiotherapie</strong>. Behandelingen worden rechtstreeks gedeclareerd, dus u ontvangt geen rekening.</p>\n                </div>\n                <div class=\"premium-card\">\n                    <span class=\"icon\">⚠️</span>\n                    <h3>Annuleringsbeleid</h3>\n                    <p>Indien een afspraak niet 24 uur van tevoren wordt afgezegd, worden de kosten bij u in rekening gebracht. Deze kosten worden niet door de zorgverzekeraar vergoed voor <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 3: TARIEVEN ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Praktijktarieven kinderfysiotherapie</h2>\n                <p><em>Alleen van toepassing indien behandeling niet wordt vergoed door de zorgverzekeraar.</em></p>\n            </div>\n\n            <div class=\"pricing-grid\">\n                <div class=\"pricing-card\">\n                    <div class=\"pricing-header\">\n                        <h3>Kinderfysiotherapie Tarieven</h3>\n                    </div>\n                    <div class=\"pricing-body\">\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Screening, intake en onderzoek</span>\n                            <span class=\"service-price\">€50,00</span>\n                        </div>\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Intake en onderzoek na verwijzing</span>\n                            <span class=\"service-price\">€47,50</span>\n                        </div>\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Kinderfysiotherapeutische zitting</span>\n                            <span class=\"service-price\">€50,00</span>\n                        </div>\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Toeslag aan huis behandeling</span>\n                            <span class=\"service-price\">€10,00</span>\n                        </div>\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Instructie/overleg ouders</span>\n                            <span class=\"service-price\">€50,00</span>\n                        </div>\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Kinderfysiotherapeutische rapportage</span>\n                            <span class=\"service-price\">€45,00</span>\n                        </div>\n                        <div class=\"price-item\">\n                            <span class=\"service-name\">Niet nagekomen afspraak</span>\n                            <span class=\"service-price\">€35,00</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"pricing-card\">\n                    <div class=\"pricing-header\">\n                        <h3>Informatie & Voorwaarden</h3>\n                    </div>\n                    <div class=\"pricing-body\">\n                        <div style=\"margin-bottom:16px; padding:16px; background:var(--primary-bg); border-radius:var(--radius-sm);\">\n                            <strong style=\"color:var(--primary);\">✓ Geen verwijzing nodig</strong>\n                            <p style=\"margin-top:4px; font-size:0.95rem; color:var(--text-muted);\">U kunt direct een afspraak maken voor <strong>kinderfysiotherapie</strong>. Geen verwijzing van de huisarts vereist.</p>\n                        </div>\n                        <div style=\"margin-bottom:16px; padding:16px; background:var(--primary-bg); border-radius:var(--radius-sm);\">\n                            <strong style=\"color:var(--primary);\">✓ Rechtstreekse declaratie</strong>\n                            <p style=\"margin-top:4px; font-size:0.95rem; color:var(--text-muted);\">Wij declareren de <strong>kinderfysiotherapie</strong> rechtstreeks bij uw zorgverzekeraar. U ontvangt geen rekening.</p>\n                        </div>\n                        <div style=\"padding:16px; background:var(--primary-bg); border-radius:var(--radius-sm);\">\n                            <strong style=\"color:var(--primary);\">✓ 18 behandelingen per jaar</strong>\n                            <p style=\"margin-top:4px; font-size:0.95rem; color:var(--text-muted);\">De basisverzekering vergoedt 18 behandelingen <strong>kinderfysiotherapie</strong> per kalenderjaar.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n       \n\n        <!-- ─── CTA ─── -->\n        <section style=\"padding:40px 0 80px;\">\n            <div class=\"cta-block\">\n                <div class=\"cta-inner\">\n                    <h2>Vragen over vergoedingen voor kinderfysiotherapie?</h2>\n                    <p>Ons team staat klaar om al uw vragen over vergoedingen en tarieven voor <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel te beantwoorden. Neem gerust contact met ons op!</p>\n                    <div class=\"btn-group\">\n                        <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                        <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"btn btn-secondary\">✉️ Stuur een e-mail</a>\n                        <a href=\"/contact/\" class=\"btn btn-secondary\">📅 Afspraak maken</a>\n                    </div>\n                    <div class=\"trust-badges\">\n                        <span>✓ Vergoed door alle zorgverzekeraars</span>\n                        <span>✓ Geen wachtlijst</span>\n                        <span>✓ Gespecialiseerde kinderfysiotherapeuten</span>\n                        <span>✓ Rechtstreekse declaratie</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- ─── SCRIPT ─── -->", "scripts": ["document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.premium-card, .pricing-card');\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.style.opacity = '1';\n                        entry.target.style.transform = 'translateY(0)';\n                    }\n                });\n            }, { threshold: 0.1 });\n\n            elements.forEach(el => {\n                el.style.opacity = '0';\n                el.style.transform = 'translateY(24px)';\n                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n                observer.observe(el);\n            });\n        });"]}