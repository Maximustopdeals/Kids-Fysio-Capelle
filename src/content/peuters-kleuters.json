{"html": "<style>\n        /* ─── PREMIUM ROOT VARIABLES ─── */\n        :root {\n            --primary: #1a5c47;\n            --primary-light: #2a7d62;\n            --primary-pale: #b5dfcb;\n            --primary-bg: #f0f9f5;\n            --white: #ffffff;\n            --text-dark: #1e2b2a;\n            --text-muted: #4a5f5c;\n            --shadow-sm: 0 4px 20px rgba(0,0,0,0.06);\n            --shadow-lg: 0 30px 80px rgba(0,0,0,0.12);\n            --radius: 20px;\n            --radius-sm: 12px;\n            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n        }\n\n        /* ─── RESET & BASE ─── */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Open Sans', sans-serif;\n            background: var(--white);\n            color: var(--text-dark);\n            line-height: 1.8;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 24px;\n        }\n\n        /* ─── TYPOGRAPHY ─── */\n        h1, h2, h3, h4 {\n            font-family: 'Nunito', sans-serif;\n            font-weight: 800;\n            line-height: 1.25;\n        }\n\n        h1 { font-size: 3.8rem; letter-spacing: -0.02em; }\n        h2 { font-size: 2.6rem; letter-spacing: -0.01em; }\n        h3 { font-size: 1.8rem; }\n        h4 { font-size: 1.3rem; }\n\n        /* ─── HERO SECTION ─── */\n        .hero {\n            position: relative;\n            min-height: 85vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: linear-gradient(165deg, #0d2f26 0%, #1a5c47 40%, #2a7d62 100%);\n            overflow: hidden;\n            isolation: isolate;\n        }\n\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            background: url('/images/KidsFysioCapelle-oefenzaal-2-1-scaled.jpg') center/cover no-repeat;\n            opacity: 0.15;\n            transform: scale(1.05);\n            will-change: transform;\n            transition: transform 8s ease;\n        }\n\n        .hero:hover .hero-bg {\n            transform: scale(1.1);\n        }\n\n        .hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: \n                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(181, 223, 203, 0.12) 0%, transparent 70%),\n                radial-gradient(ellipse 60% 50% at 80% 20%, rgba(181, 223, 203, 0.06) 0%, transparent 60%);\n            z-index: 1;\n        }\n\n        .hero::after {\n            content: '';\n            position: absolute;\n            top: -30%;\n            right: -10%;\n            width: 600px;\n            height: 600px;\n            background: radial-gradient(circle, rgba(181, 223, 203, 0.05) 0%, transparent 70%);\n            border-radius: 50%;\n            z-index: 1;\n        }\n\n        .hero-pattern {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            opacity: 0.03;\n            background-image: \n                radial-gradient(circle at 20% 50%, var(--white) 1px, transparent 1px),\n                radial-gradient(circle at 80% 20%, var(--white) 1px, transparent 1px);\n            background-size: 60px 60px;\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 2;\n            max-width: 900px;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 10px 28px;\n            background: rgba(255,255,255,0.10);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255,255,255,0.15);\n            border-radius: 100px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            color: rgba(255,255,255,0.95);\n            letter-spacing: 0.3px;\n            margin-bottom: 32px;\n            animation: fadeDown 0.8s ease both;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            fill: currentColor;\n        }\n\n        .hero h1 {\n            color: var(--white);\n            margin-bottom: 20px;\n            animation: fadeUp 0.8s ease 0.15s both;\n        }\n\n        .hero h1 span {\n            background: linear-gradient(135deg, var(--primary-pale), #e8f5ef);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.35rem;\n            color: rgba(255,255,255,0.85);\n            max-width: 700px;\n            margin: 0 auto;\n            font-weight: 400;\n            line-height: 1.6;\n            animation: fadeUp 0.8s ease 0.3s both;\n        }\n\n        .hero-cta {\n            margin-top: 40px;\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            animation: fadeUp 0.8s ease 0.45s both;\n        }\n\n        .btn {\n            padding: 16px 38px;\n            border-radius: 100px;\n            font-family: 'Nunito', sans-serif;\n            font-weight: 700;\n            font-size: 1.05rem;\n            text-decoration: none;\n            transition: var(--transition);\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--white);\n            color: var(--primary);\n            box-shadow: 0 8px 32px rgba(0,0,0,0.20);\n        }\n        .btn-primary:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 16px 48px rgba(0,0,0,0.30);\n        }\n\n        .btn-outline {\n            background: transparent;\n            color: var(--white);\n            border: 2px solid rgba(255,255,255,0.30);\n        }\n        .btn-outline:hover {\n            background: rgba(255,255,255,0.10);\n            border-color: rgba(255,255,255,0.60);\n            transform: translateY(-3px);\n        }\n\n        /* ─── ANIMATIONS ─── */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        @keyframes fadeDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ─── SECTION STYLING ─── */\n        section {\n            padding: 80px 0;\n        }\n\n        .section-intro {\n            text-align: center;\n            max-width: 780px;\n            margin: 0 auto 60px;\n        }\n\n        .section-intro h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .section-intro h2::after {\n            content: '';\n            display: block;\n            width: 70px;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            margin: 18px auto 0;\n            border-radius: 4px;\n        }\n\n        .section-intro p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            margin-top: 20px;\n        }\n\n        /* ─── CONTENT GRID ─── */\n        .grid-2 {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 60px;\n            align-items: center;\n        }\n\n        .grid-2 .image-wrap {\n            border-radius: var(--radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n            transition: var(--transition);\n        }\n        .grid-2 .image-wrap:hover {\n            transform: scale(1.01) translateY(-4px);\n        }\n        .grid-2 .image-wrap img {\n            width: 100%;\n            height: 420px;\n            object-fit: cover;\n            display: block;\n        }\n\n        .grid-2 .text-content h3 {\n            color: var(--primary);\n            margin-top: 0;\n        }\n\n        /* ─── STATS BALK ─── */\n        .stats-bar {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 20px;\n            margin-top: 50px;\n            padding: 30px 20px;\n            background: var(--primary-bg);\n            border-radius: var(--radius);\n        }\n\n        .stat-item {\n            text-align: center;\n        }\n\n        .stat-item .number {\n            font-family: 'Nunito', sans-serif;\n            font-size: 2.2rem;\n            font-weight: 900;\n            color: var(--primary);\n            display: block;\n        }\n\n        .stat-item .label {\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n\n        /* ─── GRID 2x2 ─── */\n        .grid-2x2 {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        /* ─── MILESTONE CARDS ─── */\n        .milestone-card {\n            background: var(--white);\n            padding: 32px 28px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            text-align: center;\n            transition: var(--transition);\n            border-top: 4px solid var(--primary-pale);\n        }\n\n        .milestone-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-top-color: var(--primary);\n        }\n\n        .milestone-card .icon {\n            font-size: 2.8rem;\n            margin-bottom: 16px;\n            display: block;\n        }\n\n        .milestone-card h4 {\n            color: var(--primary);\n            margin-bottom: 10px;\n        }\n\n        .milestone-card p {\n            color: var(--text-muted);\n            font-size: 0.98rem;\n        }\n\n        /* ─── FEATURE CARDS ─── */\n        .feature-card {\n            background: var(--white);\n            padding: 32px 28px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .feature-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .feature-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .feature-card .icon {\n            font-size: 2.4rem;\n            margin-bottom: 14px;\n            display: block;\n        }\n\n        .feature-card h4 {\n            color: var(--primary);\n            margin-bottom: 10px;\n        }\n\n        .feature-card p {\n            color: var(--text-muted);\n            font-size: 0.95rem;\n        }\n\n        /* ─── SECTIE 4: AFBEELDING + TEKST (gelijkmatige hoogte) ─── */\n        .grid-2x2-content {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 40px;\n            align-items: stretch;\n            margin-top: 20px;\n        }\n\n        .grid-2x2-content .image-wrap {\n            border-radius: var(--radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n            transition: var(--transition);\n            height: 100%;\n            min-height: 340px;\n            display: flex;\n            align-items: center;\n        }\n\n        .grid-2x2-content .image-wrap:hover {\n            transform: scale(1.01) translateY(-4px);\n        }\n\n        .grid-2x2-content .image-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n        }\n\n        .grid-2x2-content .text-content {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            padding: 10px 0;\n        }\n\n        .grid-2x2-content .text-content h2 {\n            color: var(--primary);\n            font-size: 2.2rem;\n            margin-bottom: 16px;\n            text-align: left;\n        }\n\n        .grid-2x2-content .text-content h2::after {\n            margin: 16px 0 0 0;\n        }\n\n        .grid-2x2-content .text-content p {\n            color: var(--text-muted);\n            margin-bottom: 4px; /* Verminderde afstand tussen alinea's */\n        }\n\n        .grid-2x2-content .text-content ul {\n            margin: 8px 0 8px 0; /* Verminderde afstand boven en onder */\n            padding-left: 24px;\n            color: var(--text-muted);\n        }\n\n        .grid-2x2-content .text-content ul li {\n            margin-bottom: 6px;\n        }\n\n        .grid-2x2-content .text-content .badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 12px 24px;\n            background: var(--primary-bg);\n            border-radius: 100px;\n            margin-top: 12px; /* Iets minder marge */\n            font-weight: 600;\n            color: var(--primary);\n            align-self: flex-start;\n        }\n\n        /* ─── INDICATIES GRID ─── */\n        .indications-grid {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 14px;\n            margin-top: 30px;\n        }\n\n        .indication-item {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            padding: 14px 18px;\n            background: var(--primary-bg);\n            border-radius: var(--radius-sm);\n            font-weight: 500;\n            color: var(--text-dark);\n            transition: var(--transition);\n        }\n\n        .indication-item:hover {\n            background: var(--primary-pale);\n            transform: translateX(6px);\n        }\n\n        .indication-item .check {\n            color: var(--primary);\n            font-weight: 800;\n            font-size: 1.1rem;\n            flex-shrink: 0;\n        }\n\n        /* ─── CTA SECTION ─── */\n        .cta-block {\n            background: linear-gradient(145deg, var(--primary-bg), var(--primary-pale));\n            border-radius: var(--radius);\n            padding: 80px 60px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            margin: 40px 0 0;\n        }\n\n        .cta-block::before {\n            content: '';\n            position: absolute;\n            top: -120px;\n            right: -120px;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(255,255,255,0.30) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block::after {\n            content: '';\n            position: absolute;\n            bottom: -150px;\n            left: -150px;\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block .cta-inner {\n            position: relative;\n            z-index: 2;\n        }\n\n        .cta-block h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .cta-block p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            max-width: 680px;\n            margin: 0 auto;\n        }\n\n        .cta-block .btn-group {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n        }\n\n        .cta-block .btn-primary {\n            background: var(--primary);\n            color: var(--white);\n        }\n        .cta-block .btn-primary:hover {\n            background: var(--primary-light);\n        }\n\n        .cta-block .btn-secondary {\n            background: var(--white);\n            color: var(--primary);\n            border: 2px solid var(--primary);\n        }\n        .cta-block .btn-secondary:hover {\n            background: var(--primary);\n            color: var(--white);\n        }\n\n        .cta-block .trust-badges {\n            display: flex;\n            justify-content: center;\n            gap: 32px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .cta-block .trust-badges span {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        /* ─── EXTERNE LINK ─── */\n        .external-link {\n            text-align: center;\n            padding: 30px 0 10px; /* Verminderde padding */\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .external-link a {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n        }\n        .external-link a:hover {\n            text-decoration: underline;\n        }\n\n        /* ─── RESPONSIVE ─── */\n        @media (max-width: 1024px) {\n            h1 { font-size: 3rem; }\n            h2 { font-size: 2.2rem; }\n            .grid-2 { grid-template-columns: 1fr; gap: 40px; }\n            .grid-2 .image-wrap { order: -1; }\n            .grid-2 .image-wrap img { height: 320px; }\n            .stats-bar { grid-template-columns: repeat(2, 1fr); }\n            .indications-grid { grid-template-columns: repeat(2, 1fr); }\n            .grid-2x2-content { grid-template-columns: 1fr; gap: 30px; }\n            .grid-2x2-content .image-wrap { min-height: 280px; }\n            .grid-2x2-content .image-wrap img { height: 280px; }\n        }\n\n        @media (max-width: 768px) {\n            h1 { font-size: 2.4rem; }\n            .hero { min-height: 70vh; padding: 60px 0; }\n            .hero-subtitle { font-size: 1.1rem; }\n            .hero-cta { flex-direction: column; align-items: center; }\n            .btn { width: 100%; max-width: 320px; justify-content: center; }\n            .grid-2x2 { grid-template-columns: 1fr; }\n            .grid-2x2-content { grid-template-columns: 1fr; gap: 24px; }\n            .grid-2x2-content .image-wrap { min-height: 220px; }\n            .grid-2x2-content .image-wrap img { height: 220px; }\n            .cta-block { padding: 50px 24px; }\n            .cta-block .trust-badges { flex-direction: column; align-items: center; gap: 12px; }\n            section { padding: 50px 0; }\n            .stats-bar { grid-template-columns: 1fr 1fr; gap: 16px; }\n            .stat-item .number { font-size: 1.8rem; }\n            .grid-2 .image-wrap img { height: 240px; }\n            .indications-grid { grid-template-columns: 1fr; }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.8rem; }\n            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }\n            .stats-bar { grid-template-columns: 1fr; }\n            .grid-2x2-content .image-wrap { min-height: 180px; }\n            .grid-2x2-content .image-wrap img { height: 180px; }\n            .grid-2x2-content .text-content h2 { font-size: 1.6rem; }\n        }\n    </style>\n\n\n\n\n    <!-- ═══ HERO ═══ -->\n    <section class=\"hero\">\n        <div class=\"hero-bg\" loading=\"lazy\"></div>\n        <div class=\"hero-pattern\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                Spelenderwijs leren bewegen\n            </div>\n            <h1><span>Kinderfysiotherapie</span> voor Peuters & Kleuters</h1>\n            <p class=\"hero-subtitle\">Professionele begeleiding voor kinderen van 2–4 jaar bij motorische ontwikkeling, houterig bewegen en veelvallen in Capelle aan den IJssel</p>\n            <div class=\"hero-cta\">\n                <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                <a href=\"/contact/\" class=\"btn btn-outline\">📅 Afspraak maken</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- ═══ MAIN CONTENT ═══ -->\n    <main class=\"container\">\n\n        <!-- ─── SECTIE 1: WAAROM + STATS ─── -->\n        <section>\n            <div class=\"section-intro\">\n                <h2>Waarom kinderfysiotherapie voor peuters en kleuters essentieel is voor een goede start</h2>\n                <p>De leeftijd van 2 tot 4 jaar is een periode van enorme motorische ontwikkeling. Bij Kids Fysio Capelle helpen we uw peuter of kleuter spelenderwijs de wereld te ontdekken met plezier in bewegen. Onze <strong>kinderfysiotherapie voor peuters en kleuters</strong> is specifiek afgestemd op deze leeftijdsgroep.</p>\n            </div>\n\n            <div class=\"grid-2\">\n                <div class=\"text-content\">\n                    <h3>Wat doet kinderfysiotherapie voor peuters en kleuters?</h3>\n                    <p>In deze cruciale fase leert uw kind lopen, rennen, springen, huppelen, gooien en vangen. Ieder kind ontwikkelt zich op zijn eigen tempo, maar sommige kinderen hebben extra ondersteuning nodig bij het aanleren van deze vaardigheden. <strong>Kinderfysiotherapie voor peuters en kleuters</strong> biedt die ondersteuning op een speelse, kindgerichte manier.</p>\n                    <p style=\"margin-top:16px;\">Wij helpen uw kind in een veilige, kindvriendelijke omgeving om met plezier te bewegen en angsten te overwinnen. Door middel van spel en beweging stimuleren we de motorische ontwikkeling op een natuurlijke manier, afgestemd op de belevingswereld van uw peuter of kleuter.</p>\n                    <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--primary-bg);border-radius:100px;margin-top:20px;font-weight:600;color:var(--primary);\">\n                        ✓ 18 behandelingen vergoed\n                    </div>\n                </div>\n                <div class=\"image-wrap\">\n                    <img src=\"/images/peuter_kleuter-behandeling-bij-kids-fysio-Capelle.png\" alt=\"Kinderfysiotherapie voor peuters en kleuters bij Kids Fysio Capelle in Capelle aan den IJssel\" loading=\"lazy\">\n                </div>\n            </div>\n\n            <!-- Stats Balk -->\n            <div class=\"stats-bar\">\n                <div class=\"stat-item\">\n                    <span class=\"number\">18</span>\n                    <span class=\"label\">Behandelingen vergoed</span>\n                </div>\n                <div class=\"stat-item\">\n                    <span class=\"number\">2-4</span>\n                    <span class=\"label\">Leeftijd peuter & kleuter</span>\n                </div>\n                <div class=\"stat-item\">\n                    <span class=\"number\">✓</span>\n                    <span class=\"label\">Geen verwijzing nodig</span>\n                </div>\n                <div class=\"stat-item\">\n                    <span class=\"number\">100%</span>\n                    <span class=\"label\">Spelenderwijs leren</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 2: MILESTONES ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Belangrijke ontwikkelingsmijlpalen voor peuters en kleuters</h2>\n                <p>In de leeftijd van 2 tot 4 jaar worden grote motorische stappen gemaakt. Dit is wat uw kind normaal gesproken kan leren.</p>\n            </div>\n\n            <div class=\"grid-2x2\">\n                <div class=\"milestone-card\">\n                    <span class=\"icon\">🏃‍♂️</span>\n                    <h4>Grove motoriek</h4>\n                    <p>Lopen, rennen, springen, klimmen en balvaardigheid ontwikkelen zich in rap tempo tijdens de <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n                <div class=\"milestone-card\">\n                    <span class=\"icon\">✍️</span>\n                    <h4>Fijne motoriek</h4>\n                    <p>Tekenen, knippen, kleuren en knutselen worden steeds beter gecoördineerd. <strong>Kinderfysiotherapie voor peuters en kleuters</strong> helpt hierbij.</p>\n                </div>\n                <div class=\"milestone-card\">\n                    <span class=\"icon\">⚖️</span>\n                    <h4>Evenwicht</h4>\n                    <p>Balans en coördinatie verbeteren, wat zorgt voor meer stabiliteit bij bewegen. Een belangrijk onderdeel van <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n                <div class=\"milestone-card\">\n                    <span class=\"icon\">🤸‍♀️</span>\n                    <h4>Zelfvertrouwen</h4>\n                    <p>Succeservaringen in bewegen bouwen zelfvertrouwen op voor nieuwe uitdagingen. Dat is het doel van onze <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 3: AANPAK ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Onze aanpak bij kinderfysiotherapie voor peuters en kleuters</h2>\n                <p>Wij werken volgens een bewezen methode die aansluit bij de belevingswereld van uw kind.</p>\n            </div>\n\n            <div class=\"grid-2x2\">\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🎯</span>\n                    <h4>Spelenderwijs Leren</h4>\n                    <p>We gebruiken speelse oefeningen en bewegingen die aansluiten bij de belevingswereld van uw kind om motorische vaardigheden te ontwikkelen binnen de <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🏠</span>\n                    <h4>Kindvriendelijke Omgeving</h4>\n                    <p>Onze praktijkruimte is speciaal ingericht voor jonge kinderen, zodat ze zich veilig en vertrouwd voelen tijdens de <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">👨‍👩‍👧</span>\n                    <h4>Ouderbetrokkenheid</h4>\n                    <p>We betrekken ouders actief bij de behandeling en geven praktische tips om de ontwikkeling thuis te stimuleren met <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">😊</span>\n                    <h4>Plezier in Bewegen</h4>\n                    <p>We helpen angsten overwinnen en laten kinderen ervaren hoe leuk bewegen kan zijn, van klimmen tot balvaardigheid tijdens de <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 4: ANGER OVERWINNEN (verbeterde afbeelding + compacte witruimte) ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"grid-2x2-content\">\n                <div class=\"image-wrap\">\n                    <img src=\"/images/peuter_kleuter-behandeling-bij-kids-fysio-Capelle2.jpg\" alt=\"Kinderfysiotherapie voor peuters en kleuters met oefeningen bij Kids Fysio Capelle\" loading=\"lazy\">\n                </div>\n                <div class=\"text-content\">\n                    <h2>Angsten overwinnen met kinderfysiotherapie</h2>\n                    <p>Veel jonge kinderen hebben angsten voor bewegen, zoals klimmen, klauteren of het vangen van een bal. Wij helpen uw kind stap voor stap deze angsten te overwinnen door:</p>\n                    <ul>\n                        <li>Kleine, haalbare stapjes in de oefeningen</li>\n                        <li>Veel positieve bekrachtiging en aanmoediging</li>\n                        <li>Aansluiten bij de interesses van uw kind</li>\n                        <li>Een veilige en uitdagende speelomgeving</li>\n                    </ul>\n                    <p>Zo bouwen we aan zelfvertrouwen en plezier in bewegen met <strong>kinderfysiotherapie voor peuters en kleuters</strong>!</p>\n                    <div class=\"badge\">\n                        ✓ Geen verwijzing nodig\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 5: INDICATIES ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2 style=\"color:var(--primary);\">Indicaties voor kinderfysiotherapie peuters en kleuters</h2>\n                <p>Herkenbaar bij uw peuter of kleuter? Wij helpen graag bij deze en andere indicaties.</p>\n            </div>\n\n            <div class=\"indications-grid\">\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Motorische ontwikkelingsachterstand</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Afwijkend looppatroon</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Houterig bewegen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Veelvuldig vallen en struikelen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Het onhandige kind</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Hypermobiliteit</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Moeite met gooien en vangen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Angst voor bewegen en klimmen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Tenelopen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Groeipijn in de benen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Schrijfproblemen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Moeite met knippen en kleuren</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Snel moe, niet zelf willen lopen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Ademhalingsproblemen</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Jeugdreuma</div>\n                <div class=\"indication-item\"><span class=\"check\">✓</span> Anders bewegen na gips</div>\n            </div>\n\n            <p style=\"text-align:center; margin-top:30px; color:var(--text-muted);\">\n                Staat de indicatie er niet tussen? <a href=\"/contact/\" style=\"color:var(--primary);font-weight:600;\">Neem contact op</a> voor persoonlijk advies over <strong>kinderfysiotherapie voor peuters en kleuters</strong>.\n            </p>\n        </section>\n\n        \n        <!-- ─── CTA ─── -->\n        <section style=\"padding:40px 0 80px;\">\n            <div class=\"cta-block\">\n                <div class=\"cta-inner\">\n                    <h2>Ziet u ontwikkelingsuitdagingen bij uw peuter of kleuter?</h2>\n                    <p>Onze gespecialiseerde kinderfysiotherapeuten helpen uw kind met plezier te leren bewegen en zich optimaal te ontwikkelen met <strong>kinderfysiotherapie voor peuters en kleuters</strong>.</p>\n                    <div class=\"btn-group\">\n                        <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                        <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"btn btn-secondary\">✉️ Stuur een e-mail</a>\n                        <a href=\"/contact/\" class=\"btn btn-secondary\">📅 Afspraak maken</a>\n                    </div>\n                    <div class=\"trust-badges\">\n                        <span>✓ Vergoed door alle zorgverzekeraars</span>\n                        <span>✓ Geen wachtlijst</span>\n                        <span>✓ Gespecialiseerde kinderfysiotherapeuten</span>\n                        <span>✓ Kindvriendelijke omgeving</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- ─── SCRIPT ─── -->", "scripts": ["document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.feature-card, .indication-item, .milestone-card');\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.style.opacity = '1';\n                        entry.target.style.transform = 'translateY(0)';\n                    }\n                });\n            }, { threshold: 0.1 });\n\n            elements.forEach(el => {\n                el.style.opacity = '0';\n                el.style.transform = 'translateY(24px)';\n                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n                observer.observe(el);\n            });\n        });"]}