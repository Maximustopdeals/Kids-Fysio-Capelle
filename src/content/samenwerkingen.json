{"html": "<style>\n        /* ─── PREMIUM ROOT VARIABLES ─── */\n        :root {\n            --primary: #1a5c47;\n            --primary-light: #2a7d62;\n            --primary-pale: #b5dfcb;\n            --primary-bg: #f0f9f5;\n            --white: #ffffff;\n            --text-dark: #1e2b2a;\n            --text-muted: #4a5f5c;\n            --shadow-sm: 0 4px 20px rgba(0,0,0,0.06);\n            --shadow-lg: 0 30px 80px rgba(0,0,0,0.12);\n            --radius: 20px;\n            --radius-sm: 12px;\n            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n        }\n\n        /* ─── RESET & BASE ─── */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Open Sans', sans-serif;\n            background: var(--white);\n            color: var(--text-dark);\n            line-height: 1.8;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 24px;\n        }\n\n        /* ─── TYPOGRAPHY ─── */\n        h1, h2, h3, h4 {\n            font-family: 'Nunito', sans-serif;\n            font-weight: 800;\n            line-height: 1.25;\n        }\n\n        h1 { font-size: 3.8rem; letter-spacing: -0.02em; }\n        h2 { font-size: 2.6rem; letter-spacing: -0.01em; }\n        h3 { font-size: 1.8rem; }\n        h4 { font-size: 1.3rem; }\n\n        /* ─── HERO SECTION ─── */\n        .hero {\n            position: relative;\n            min-height: 70vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: linear-gradient(165deg, #0d2f26 0%, #1a5c47 40%, #2a7d62 100%);\n            overflow: hidden;\n            isolation: isolate;\n        }\n\n        .hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: \n                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(181, 223, 203, 0.12) 0%, transparent 70%),\n                radial-gradient(ellipse 60% 50% at 80% 20%, rgba(181, 223, 203, 0.06) 0%, transparent 60%);\n            z-index: 1;\n        }\n\n        .hero::after {\n            content: '';\n            position: absolute;\n            top: -30%;\n            right: -10%;\n            width: 600px;\n            height: 600px;\n            background: radial-gradient(circle, rgba(181, 223, 203, 0.05) 0%, transparent 70%);\n            border-radius: 50%;\n            z-index: 1;\n        }\n\n        .hero-pattern {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            opacity: 0.03;\n            background-image: \n                radial-gradient(circle at 20% 50%, var(--white) 1px, transparent 1px),\n                radial-gradient(circle at 80% 20%, var(--white) 1px, transparent 1px);\n            background-size: 60px 60px;\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 2;\n            max-width: 900px;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 10px 28px;\n            background: rgba(255,255,255,0.10);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255,255,255,0.15);\n            border-radius: 100px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            color: rgba(255,255,255,0.95);\n            letter-spacing: 0.3px;\n            margin-bottom: 32px;\n            animation: fadeDown 0.8s ease both;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            fill: currentColor;\n        }\n\n        .hero h1 {\n            color: var(--white);\n            margin-bottom: 20px;\n            animation: fadeUp 0.8s ease 0.15s both;\n        }\n\n        .hero h1 span {\n            background: linear-gradient(135deg, var(--primary-pale), #e8f5ef);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.35rem;\n            color: rgba(255,255,255,0.85);\n            max-width: 700px;\n            margin: 0 auto;\n            font-weight: 400;\n            line-height: 1.6;\n            animation: fadeUp 0.8s ease 0.3s both;\n        }\n\n        .hero-cta {\n            margin-top: 40px;\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            animation: fadeUp 0.8s ease 0.45s both;\n        }\n\n        .btn {\n            padding: 16px 38px;\n            border-radius: 100px;\n            font-family: 'Nunito', sans-serif;\n            font-weight: 700;\n            font-size: 1.05rem;\n            text-decoration: none;\n            transition: var(--transition);\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--white);\n            color: var(--primary);\n            box-shadow: 0 8px 32px rgba(0,0,0,0.20);\n        }\n        .btn-primary:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 16px 48px rgba(0,0,0,0.30);\n        }\n\n        .btn-outline {\n            background: transparent;\n            color: var(--white);\n            border: 2px solid rgba(255,255,255,0.30);\n        }\n        .btn-outline:hover {\n            background: rgba(255,255,255,0.10);\n            border-color: rgba(255,255,255,0.60);\n            transform: translateY(-3px);\n        }\n\n        /* ─── ANIMATIONS ─── */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        @keyframes fadeDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ─── SECTION STYLING ─── */\n        section {\n            padding: 80px 0;\n        }\n\n        .section-intro {\n            text-align: center;\n            max-width: 780px;\n            margin: 0 auto 60px;\n        }\n\n        .section-intro h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .section-intro h2::after {\n            content: '';\n            display: block;\n            width: 70px;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            margin: 18px auto 0;\n            border-radius: 4px;\n        }\n\n        .section-intro p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            margin-top: 20px;\n        }\n\n        /* ─── SECTION LIGHT ─── */\n        .section-light {\n            background: var(--primary-bg);\n        }\n\n        /* ─── CONTENT GRID 2x ─── */\n        .grid-2 {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 60px;\n            align-items: start;\n        }\n\n        .grid-2 .text-content h3 {\n            color: var(--primary);\n            margin-top: 0;\n        }\n\n        /* ─── PARTNERS GRID 2x2 ─── */\n        .partners-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        .partner-card {\n            background: var(--white);\n            padding: 35px 28px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .partner-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .partner-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .partner-card .logo {\n            width: 160px;\n            height: 100px;\n            margin: 0 auto 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--white);\n            border-radius: var(--radius-sm);\n            border: 2px solid var(--primary-pale);\n            padding: 15px;\n            transition: var(--transition);\n        }\n\n        .partner-card .logo:hover {\n            border-color: var(--primary);\n        }\n\n        .partner-card .logo img {\n            max-width: 100%;\n            max-height: 100%;\n            object-fit: contain;\n        }\n\n        .partner-card .logo-placeholder {\n            color: var(--primary);\n            font-size: 1.8rem;\n            font-weight: 800;\n            text-align: center;\n            line-height: 1.2;\n        }\n\n        .partner-card h3 {\n            color: var(--primary);\n            font-size: 1.4rem;\n            margin-bottom: 8px;\n        }\n\n        .partner-card p {\n            color: var(--text-muted);\n            font-size: 0.95rem;\n            margin-bottom: 12px;\n        }\n\n        .partner-card .partner-link {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 0.95rem;\n            transition: var(--transition);\n            display: inline-block;\n        }\n\n        .partner-card .partner-link:hover {\n            color: var(--primary-light);\n            transform: translateX(4px);\n        }\n\n        /* ─── SCHOOLS GRID 4x ─── */\n        .schools-grid {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 25px;\n            margin-top: 20px;\n        }\n\n        .school-link {\n            display: block;\n            padding: 20px;\n            background: var(--white);\n            border-radius: var(--radius-sm);\n            border: 2px solid var(--primary-pale);\n            transition: var(--transition);\n            text-decoration: none;\n        }\n\n        .school-link:hover {\n            transform: translateY(-5px);\n            border-color: var(--primary);\n            box-shadow: var(--shadow-sm);\n        }\n\n        .school-link img {\n            max-width: 100%;\n            max-height: 80px;\n            object-fit: contain;\n            display: block;\n            margin: 0 auto;\n        }\n\n        /* ─── SPECIALIST LIST ─── */\n        .specialist-list {\n            list-style: none;\n            padding: 0;\n            margin: 16px 0 20px;\n        }\n\n        .specialist-list li {\n            padding: 10px 0 10px 30px;\n            position: relative;\n            border-bottom: 1px solid var(--primary-bg);\n            color: var(--text-muted);\n            font-size: 0.98rem;\n        }\n\n        .specialist-list li:last-child {\n            border-bottom: none;\n        }\n\n        .specialist-list li::before {\n            content: \"✓\";\n            position: absolute;\n            left: 0;\n            top: 10px;\n            color: var(--primary);\n            font-weight: 800;\n            font-size: 1.1rem;\n        }\n\n        .specialist-list li strong {\n            color: var(--text-dark);\n        }\n\n        /* ─── CTA SECTION ─── */\n        .cta-block {\n            background: linear-gradient(145deg, var(--primary-bg), var(--primary-pale));\n            border-radius: var(--radius);\n            padding: 80px 60px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            margin: 40px 0 0;\n        }\n\n        .cta-block::before {\n            content: '';\n            position: absolute;\n            top: -120px;\n            right: -120px;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(255,255,255,0.30) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block::after {\n            content: '';\n            position: absolute;\n            bottom: -150px;\n            left: -150px;\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block .cta-inner {\n            position: relative;\n            z-index: 2;\n        }\n\n        .cta-block h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .cta-block p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            max-width: 680px;\n            margin: 0 auto;\n        }\n\n        .cta-block .btn-group {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n        }\n\n        .cta-block .btn-primary {\n            background: var(--primary);\n            color: var(--white);\n        }\n        .cta-block .btn-primary:hover {\n            background: var(--primary-light);\n        }\n\n        .cta-block .btn-secondary {\n            background: var(--white);\n            color: var(--primary);\n            border: 2px solid var(--primary);\n        }\n        .cta-block .btn-secondary:hover {\n            background: var(--primary);\n            color: var(--white);\n        }\n\n        .cta-block .trust-badges {\n            display: flex;\n            justify-content: center;\n            gap: 32px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .cta-block .trust-badges span {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        /* ─── EXTERNE LINK ─── */\n        .external-link {\n            text-align: center;\n            padding: 30px 0 10px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .external-link a {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n        }\n        .external-link a:hover {\n            text-decoration: underline;\n        }\n\n        /* ─── RESPONSIVE ─── */\n        @media (max-width: 1024px) {\n            h1 { font-size: 3rem; }\n            h2 { font-size: 2.2rem; }\n            .grid-2 { grid-template-columns: 1fr; gap: 40px; }\n            .partners-grid { grid-template-columns: 1fr 1fr; }\n            .schools-grid { grid-template-columns: repeat(2, 1fr); }\n        }\n\n        @media (max-width: 768px) {\n            h1 { font-size: 2.4rem; }\n            .hero { min-height: 70vh; padding: 60px 0; }\n            .hero-subtitle { font-size: 1.1rem; }\n            .hero-cta { flex-direction: column; align-items: center; }\n            .btn { width: 100%; max-width: 320px; justify-content: center; }\n            .partners-grid { grid-template-columns: 1fr; max-width: 420px; margin-left: auto; margin-right: auto; }\n            .schools-grid { grid-template-columns: 1fr 1fr; }\n            .cta-block { padding: 50px 24px; }\n            .cta-block .trust-badges { flex-direction: column; align-items: center; gap: 12px; }\n            section { padding: 50px 0; }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.8rem; }\n            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }\n            .partner-card { padding: 25px 20px; }\n            .partner-card .logo { width: 130px; height: 80px; }\n            .schools-grid { grid-template-columns: 1fr; max-width: 300px; margin-left: auto; margin-right: auto; }\n            .cta-block { padding: 40px 18px; }\n        }\n    </style>\n\n\n\n\n    <!-- ═══ HERO ═══ -->\n    <section class=\"hero\">\n        <div class=\"hero-pattern\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                Multidisciplinaire zorg\n            </div>\n            <h1><span>Samenwerkingen</span> voor optimale zorg</h1>\n            <p class=\"hero-subtitle\">Kids Fysio Capelle werkt intensief samen met huisartsen, scholen, specialisten en organisaties in Capelle aan den IJssel voor de beste <strong>kinderfysiotherapie</strong>.</p>\n            <div class=\"hero-cta\">\n                <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                <a href=\"/contact/\" class=\"btn btn-outline\">📅 Afspraak maken</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- ═══ MAIN CONTENT ═══ -->\n    <main class=\"container\">\n\n        <!-- ─── SECTIE 1: MULTIDISCIPLINAIR ─── -->\n        <section>\n            <div class=\"section-intro\">\n                <h2>Multidisciplinaire samenwerking in kinderfysiotherapie</h2>\n                <p>Bij Kids Fysio Capelle vinden wij het belangrijk om multidisciplinair te werken voor de beste <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel. Wanneer een probleem meer aandacht vraagt, is het prettig om hier snel in te kunnen schakelen.</p>\n            </div>\n\n            <div class=\"grid-2\">\n                <div class=\"text-content\">\n                    <h3>Samenwerking met zorgprofessionals</h3>\n                    <p>Wij hebben nauw contact met de huisartsen, het consultatiebureau, de osteopaat, de kindermanueeltherapeut en nog vele andere disciplines in de regio voor optimale <strong>kinderfysiotherapie</strong>.</p>\n                    <p style=\"margin-top:16px;\">Door deze intensieve samenwerking kunnen wij snel schakelen tussen disciplines, integrale behandelplannen opstellen en expertise delen tussen specialisten binnen de <strong>kinderfysiotherapie</strong>.</p>\n                    <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--primary-bg);border-radius:100px;margin-top:20px;font-weight:600;color:var(--primary);\">\n                        ✓ Multidisciplinair team\n                    </div>\n                </div>\n                <div class=\"text-content\">\n                    <h3>Samenwerking met scholen</h3>\n                    <p>Kids Fysio Capelle werkt samen met diverse basisscholen in Capelle aan den IJssel. Wij observeren en behandelen indien nodig de kinderen op school voor <strong>kinderfysiotherapie</strong>. Er is nauw contact met de leerkrachten en de intern begeleiders.</p>\n                    <p style=\"margin-top:16px;\">Zo kunnen wij een behandelplan aanbieden in de setting waar de hulpvraag zich afspeelt en alle betrokkenen in het behandeltraject meenemen binnen de <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 2: WIJK-JEUGDOVERLEG ─── -->\n        <section style=\"padding-top:20px;\" class=\"section-light\">\n            <div class=\"container\" style=\"padding:80px 0;\">\n                <div class=\"section-intro\">\n                    <h2>Betrokken in de wijk Oostgaarde</h2>\n                    <p>Kids Fysio Capelle is aangesloten bij het wijk-jeugdoverleg van de wijk Oostgaarde in Capelle aan den IJssel voor optimale <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n                <div style=\"max-width: 780px; margin: 0 auto; text-align: center;\">\n                    <p style=\"font-size:1.1rem; color:var(--text-muted);\">In dit overleg zitten onder andere de buurtcoach, de gemeente, Welzijn Capelle, Sportief Capelle, de scholen, het Centrum voor Jeugd en Gezin en de wijkagent.</p>\n                    <p style=\"font-size:1.1rem; color:var(--text-muted); margin-top:16px;\">Tijdens dit overleg wordt er vanuit ieders oogpunt gekeken naar wat er speelt en leeft in de wijk. Wij brainstormen met elkaar om vanuit elkaars expertise optimaal te kunnen inspelen op en aansluiten bij de jeugd van de wijk Oostgaarde voor <strong>kinderfysiotherapie</strong>.</p>\n                    <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--white);border-radius:100px;margin-top:24px;font-weight:600;color:var(--primary);box-shadow:var(--shadow-sm);\">\n                        ✓ Wijk Oostgaarde\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 3: PARTNERS ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Onze samenwerkingspartners</h2>\n                <p>Samen met gespecialiseerde organisaties bieden wij de beste <strong>kinderfysiotherapie</strong> in Capelle aan den IJssel.</p>\n            </div>\n\n            <div class=\"partners-grid\">\n                <!-- CityKids -->\n                <div class=\"partner-card\">\n                    <div class=\"logo\">\n                        <img src=\"/images/Logo-CityKids.png\" alt=\"CityKids - Samenwerkingspartner voor kinderfysiotherapie in Capelle aan den IJssel\">\n                    </div>\n                    <h3>CityKids</h3>\n                    <p>Medische kindzorg voor kinderen van 0 tot 23 jaar. Wij behandelen kinderen met ontwikkelingsachterstanden en prikkelverwerkingsproblemen binnen de <strong>kinderfysiotherapie</strong>.</p>\n                    <a href=\"https://www.citykids.nl/\" class=\"partner-link\" target=\"_blank\">Bezoek website →</a>\n                </div>\n\n                <!-- CVV Zwervers -->\n                <div class=\"partner-card\">\n                    <div class=\"logo\">\n                        <img src=\"/images/logo-cvv-zwervers.webp\" alt=\"CVV Zwervers - Samenwerkingspartner voor kinderfysiotherapie in Capelle aan den IJssel\">\n                    </div>\n                    <h3>CVV Zwervers</h3>\n                    <p>Mellisa draait iedere maandagavond een blessurespreekuur voor de jeugdleden. Ook zijn wij intensief betrokken bij het internationale U13 toernooi voor <strong>kinderfysiotherapie</strong>.</p>\n                    <a href=\"https://cvvzwervers.nl/component/finder/search?q=blessure+spreekuur+&Itemid=101\" class=\"partner-link\" target=\"_blank\">Bezoek website →</a>\n                </div>\n\n                <!-- FS Fysio -->\n                <div class=\"partner-card\">\n                    <div class=\"logo\">\n                        <div class=\"logo-placeholder\">FS</div>\n                    </div>\n                    <h3>FS Fysio</h3>\n                    <p>Bekkenfysiotherapie voor kinderen met poep- of plasproblemen. Gespecialiseerde <strong>kinderfysiotherapie</strong> in samenwerking met het IJsselland ziekenhuis.</p>\n                    <a href=\"https://www.fsfysio.nl/bekkenfysiotherapie/kinder_bekkenfysiotherapie/\" class=\"partner-link\" target=\"_blank\">Bezoek website →</a>\n                </div>\n\n                <!-- Slaapcoach -->\n                <div class=\"partner-card\">\n                    <div class=\"logo\">\n                        <div class=\"logo-placeholder\">Slaap<br>coach</div>\n                    </div>\n                    <h3>Slaapcoach</h3>\n                    <p>Baby- & kinderslaapcoach voor professionele begeleiding bij slaapproblemen bij kinderen, in aanvulling op <strong>kinderfysiotherapie</strong>.</p>\n                    <a href=\"https://www.slaapdoormetfloor.nl/\" class=\"partner-link\" target=\"_blank\">Bezoek website →</a>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 4: SPECIALISTEN ─── -->\n        <section style=\"padding-top:20px;\" class=\"section-light\">\n            <div class=\"container\" style=\"padding:80px 0;\">\n                <div class=\"section-intro\">\n                    <h2>Gespecialiseerde samenwerkingen</h2>\n                    <p>Voor specialistische zorg werken wij samen met deze experts in <strong>kinderfysiotherapie</strong>.</p>\n                </div>\n\n                <div class=\"grid-2\">\n                    <div class=\"text-content\">\n                        <h3>Bekkenfysiotherapie</h3>\n                        <p>Voor kinderen met poep- of plasproblemen werken wij samen met FS Fysio. Bekkenfysiotherapeut Jolanda is gespecialiseerd in het behandelen van kinderen en werkt nauw samen met het IJsselland ziekenhuis.</p>\n                        <p>Zij draait ook het <a href=\"https://www.ysl.nl/specialismen/picobelly-polikliniek/\" class=\"partner-link\" target=\"_blank\">Picobelly spreekuur</a> in het ziekenhuis.</p>\n                    </div>\n                    <div class=\"text-content\">\n                        <h3>Kindermanueeltherapie</h3>\n                        <p>Voor gespecialiseerde manuele therapie voor kinderen werken wij samen met:</p>\n                        <ul class=\"specialist-list\">\n                            <li><strong>Fysiotherapie Heiszwolf</strong> - Nicole Overmaat & Peter Heiszwolf</li>\n                            <li><strong>FS Fysio</strong> - Jasper Bier</li>\n                        </ul>\n                        <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--white);border-radius:100px;margin-top:12px;font-weight:600;color:var(--primary);box-shadow:var(--shadow-sm);\">\n                            ✓ Specialistische zorg\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 5: BASISSCHOLEN ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Samenwerking met basisscholen</h2>\n                <p>Wij werken intensief samen met deze basisscholen in Capelle aan den IJssel voor <strong>kinderfysiotherapie</strong> op school.</p>\n            </div>\n\n            <div class=\"schools-grid\">\n                <a href=\"https://www.horizoncapelle.nl/\" class=\"school-link\" target=\"_blank\">\n                    <img src=\"/images/pcb-De-Horizon-Capelle-aan-den-IJssel.png\" alt=\"PCB De Horizon - Samenwerkingsschool voor kinderfysiotherapie in Capelle aan den IJssel\">\n                </a>\n                <a href=\"https://www.groencapelle.nl/\" class=\"school-link\" target=\"_blank\">\n                    <img src=\"/images/Groen-van-Prinstererschool.png\" alt=\"Groen van Prinstererschool - Samenwerkingsschool voor kinderfysiotherapie in Capelle aan den IJssel\">\n                </a>\n                <a href=\"https://www.obsdecatamaran.nl/\" class=\"school-link\" target=\"_blank\">\n                    <img src=\"/images/logo_OBS-catamaran.png\" alt=\"OBS De Catamaran - Samenwerkingsschool voor kinderfysiotherapie in Capelle aan den IJssel\">\n                </a>\n                <a href=\"https://ikccornelishaak.nl/\" class=\"school-link\" target=\"_blank\">\n                    <img src=\"/images/IKC-Cornelis-Haak.png\" alt=\"IKC Cornelis Haak - Samenwerkingsschool voor kinderfysiotherapie in Capelle aan den IJssel\">\n                </a>\n            </div>\n        \n\n        <!-- ─── CTA ─── -->\n        <section style=\"padding:40px 0 80px;\">\n            <div class=\"cta-block\">\n                <div class=\"cta-inner\">\n                    <h2>Heeft u vragen over onze samenwerkingen?</h2>\n                    <p>Neem contact op voor meer informatie over hoe wij samenwerken met specialisten en scholen in Capelle aan den IJssel voor de beste <strong>kinderfysiotherapie</strong>.</p>\n                    <div class=\"btn-group\">\n                        <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                        <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"btn btn-secondary\">✉️ Stuur een e-mail</a>\n                        <a href=\"/contact/\" class=\"btn btn-secondary\">📅 Afspraak maken</a>\n                    </div>\n                    <div class=\"trust-badges\">\n                        <span>✓ Multidisciplinaire zorg</span>\n                        <span>✓ Samenwerking met scholen</span>\n                        <span>✓ Gespecialiseerde partners</span>\n                        <span>✓ Wijkgerichte aanpak</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- ─── SCRIPT ─── -->", "scripts": ["document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.partner-card, .school-link');\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.style.opacity = '1';\n                        entry.target.style.transform = 'translateY(0)';\n                    }\n                });\n            }, { threshold: 0.1 });\n\n            elements.forEach(el => {\n                el.style.opacity = '0';\n                el.style.transform = 'translateY(24px)';\n                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n                observer.observe(el);\n            });\n        });"]}