{"html": "<style>\n        /* ─── PREMIUM ROOT VARIABLES ─── */\n        :root {\n            --primary: #1a5c47;\n            --primary-light: #2a7d62;\n            --primary-pale: #b5dfcb;\n            --primary-bg: #f0f9f5;\n            --white: #ffffff;\n            --text-dark: #1e2b2a;\n            --text-muted: #4a5f5c;\n            --shadow-sm: 0 4px 20px rgba(0,0,0,0.06);\n            --shadow-lg: 0 30px 80px rgba(0,0,0,0.12);\n            --radius: 20px;\n            --radius-sm: 12px;\n            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n        }\n\n        /* ─── RESET & BASE ─── */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Open Sans', sans-serif;\n            background: var(--white);\n            color: var(--text-dark);\n            line-height: 1.8;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 24px;\n        }\n\n        /* ─── TYPOGRAPHY ─── */\n        h1, h2, h3, h4 {\n            font-family: 'Nunito', sans-serif;\n            font-weight: 800;\n            line-height: 1.25;\n        }\n\n        h1 { font-size: 3.8rem; letter-spacing: -0.02em; }\n        h2 { font-size: 2.6rem; letter-spacing: -0.01em; }\n        h3 { font-size: 1.8rem; }\n        h4 { font-size: 1.3rem; }\n\n        /* ─── HERO SECTION ─── */\n        .hero {\n            position: relative;\n            min-height: 85vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: linear-gradient(165deg, #0d2f26 0%, #1a5c47 40%, #2a7d62 100%);\n            overflow: hidden;\n            isolation: isolate;\n        }\n\n        /* Achtergrondfoto met lazy loading */\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            background: url('/images/Header-voor-Sensorische-informatieverwerking.webp') center/cover no-repeat;\n            opacity: 0.15;\n            transform: scale(1.05);\n            will-change: transform;\n            transition: transform 8s ease;\n        }\n\n        .hero:hover .hero-bg {\n            transform: scale(1.1);\n        }\n\n        .hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: \n                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(181, 223, 203, 0.12) 0%, transparent 70%),\n                radial-gradient(ellipse 60% 50% at 80% 20%, rgba(181, 223, 203, 0.06) 0%, transparent 60%);\n            z-index: 1;\n        }\n\n        .hero::after {\n            content: '';\n            position: absolute;\n            top: -30%;\n            right: -10%;\n            width: 600px;\n            height: 600px;\n            background: radial-gradient(circle, rgba(181, 223, 203, 0.05) 0%, transparent 70%);\n            border-radius: 50%;\n            z-index: 1;\n        }\n\n        .hero-pattern {\n            position: absolute;\n            inset: 0;\n            z-index: 0;\n            opacity: 0.03;\n            background-image: \n                radial-gradient(circle at 20% 50%, var(--white) 1px, transparent 1px),\n                radial-gradient(circle at 80% 20%, var(--white) 1px, transparent 1px);\n            background-size: 60px 60px;\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 2;\n            max-width: 900px;\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            padding: 10px 28px;\n            background: rgba(255,255,255,0.10);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255,255,255,0.15);\n            border-radius: 100px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            color: rgba(255,255,255,0.95);\n            letter-spacing: 0.3px;\n            margin-bottom: 32px;\n            animation: fadeDown 0.8s ease both;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            fill: currentColor;\n        }\n\n        .hero h1 {\n            color: var(--white);\n            margin-bottom: 20px;\n            animation: fadeUp 0.8s ease 0.15s both;\n        }\n\n        .hero h1 span {\n            background: linear-gradient(135deg, var(--primary-pale), #e8f5ef);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.35rem;\n            color: rgba(255,255,255,0.85);\n            max-width: 700px;\n            margin: 0 auto;\n            font-weight: 400;\n            line-height: 1.6;\n            animation: fadeUp 0.8s ease 0.3s both;\n        }\n\n        .hero-cta {\n            margin-top: 40px;\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            animation: fadeUp 0.8s ease 0.45s both;\n        }\n\n        .btn {\n            padding: 16px 38px;\n            border-radius: 100px;\n            font-family: 'Nunito', sans-serif;\n            font-weight: 700;\n            font-size: 1.05rem;\n            text-decoration: none;\n            transition: var(--transition);\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--white);\n            color: var(--primary);\n            box-shadow: 0 8px 32px rgba(0,0,0,0.20);\n        }\n        .btn-primary:hover {\n            transform: translateY(-3px) scale(1.02);\n            box-shadow: 0 16px 48px rgba(0,0,0,0.30);\n        }\n\n        .btn-outline {\n            background: transparent;\n            color: var(--white);\n            border: 2px solid rgba(255,255,255,0.30);\n        }\n        .btn-outline:hover {\n            background: rgba(255,255,255,0.10);\n            border-color: rgba(255,255,255,0.60);\n            transform: translateY(-3px);\n        }\n\n        /* ─── ANIMATIONS ─── */\n        @keyframes fadeUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        @keyframes fadeDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ─── SECTION STYLING ─── */\n        section {\n            padding: 80px 0;\n        }\n\n        .section-intro {\n            text-align: center;\n            max-width: 780px;\n            margin: 0 auto 60px;\n        }\n\n        .section-intro h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .section-intro h2::after {\n            content: '';\n            display: block;\n            width: 70px;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            margin: 18px auto 0;\n            border-radius: 4px;\n        }\n\n        .section-intro p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            margin-top: 20px;\n        }\n\n        /* ─── CONTENT GRID ─── */\n        .grid-2 {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 60px;\n            align-items: center;\n        }\n\n        .grid-2 .image-wrap {\n            border-radius: var(--radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n            transition: var(--transition);\n        }\n        .grid-2 .image-wrap:hover {\n            transform: scale(1.01) translateY(-4px);\n        }\n        .grid-2 .image-wrap img {\n            width: 100%;\n            height: 420px;\n            object-fit: cover;\n            display: block;\n        }\n\n        .grid-2 .text-content h3 {\n            color: var(--primary);\n            margin-top: 0;\n        }\n\n        /* ─── STATS BALK ─── */\n        .stats-bar {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 20px;\n            margin-top: 50px;\n            padding: 30px 20px;\n            background: var(--primary-bg);\n            border-radius: var(--radius);\n        }\n\n        .stat-item {\n            text-align: center;\n        }\n\n        .stat-item .number {\n            font-family: 'Nunito', sans-serif;\n            font-size: 2.2rem;\n            font-weight: 900;\n            color: var(--primary);\n            display: block;\n        }\n\n        .stat-item .label {\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n\n        /* ─── GRID 2x2 ─── */\n        .grid-2x2 {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 30px;\n            margin-top: 20px;\n        }\n\n        /* ─── FEATURE CARDS ─── */\n        .feature-card {\n            background: var(--white);\n            padding: 32px 28px;\n            border-radius: var(--radius);\n            box-shadow: var(--shadow-sm);\n            border: 1px solid rgba(26, 92, 71, 0.06);\n            transition: var(--transition);\n            position: relative;\n            overflow: hidden;\n            text-align: center;\n        }\n\n        .feature-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--primary-pale), var(--primary-light));\n            border-radius: 4px 4px 0 0;\n        }\n\n        .feature-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: var(--primary-pale);\n        }\n\n        .feature-card .icon {\n            font-size: 2.4rem;\n            margin-bottom: 14px;\n            display: block;\n        }\n\n        .feature-card h4 {\n            color: var(--primary);\n            margin-bottom: 10px;\n        }\n\n        .feature-card p {\n            color: var(--text-muted);\n            font-size: 0.95rem;\n        }\n\n        /* ─── SIGNALEN LIJST ─── */\n        .signalen-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 12px;\n            margin: 20px 0 10px;\n        }\n\n        .signaal-item {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            padding: 12px 18px;\n            background: var(--primary-bg);\n            border-radius: var(--radius-sm);\n            font-weight: 500;\n            color: var(--text-dark);\n            transition: var(--transition);\n        }\n\n        .signaal-item:hover {\n            background: var(--primary-pale);\n            transform: translateX(6px);\n        }\n\n        .signaal-item .check {\n            color: var(--primary);\n            font-weight: 800;\n            font-size: 1.1rem;\n            flex-shrink: 0;\n        }\n\n        /* ─── CTA SECTION ─── */\n        .cta-block {\n            background: linear-gradient(145deg, var(--primary-bg), var(--primary-pale));\n            border-radius: var(--radius);\n            padding: 80px 60px;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            margin: 40px 0 0;\n        }\n\n        .cta-block::before {\n            content: '';\n            position: absolute;\n            top: -120px;\n            right: -120px;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(255,255,255,0.30) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block::after {\n            content: '';\n            position: absolute;\n            bottom: -150px;\n            left: -150px;\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);\n            border-radius: 50%;\n        }\n\n        .cta-block .cta-inner {\n            position: relative;\n            z-index: 2;\n        }\n\n        .cta-block h2 {\n            color: var(--primary);\n            margin-bottom: 16px;\n        }\n\n        .cta-block p {\n            font-size: 1.15rem;\n            color: var(--text-muted);\n            max-width: 680px;\n            margin: 0 auto;\n        }\n\n        .cta-block .btn-group {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n        }\n\n        .cta-block .btn-primary {\n            background: var(--primary);\n            color: var(--white);\n        }\n        .cta-block .btn-primary:hover {\n            background: var(--primary-light);\n        }\n\n        .cta-block .btn-secondary {\n            background: var(--white);\n            color: var(--primary);\n            border: 2px solid var(--primary);\n        }\n        .cta-block .btn-secondary:hover {\n            background: var(--primary);\n            color: var(--white);\n        }\n\n        .cta-block .trust-badges {\n            display: flex;\n            justify-content: center;\n            gap: 32px;\n            flex-wrap: wrap;\n            margin-top: 32px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .cta-block .trust-badges span {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        /* ─── EXTERNE LINK ─── */\n        .external-link {\n            text-align: center;\n            padding: 30px 0 10px;\n            font-size: 0.95rem;\n            color: var(--text-muted);\n        }\n        .external-link a {\n            color: var(--primary);\n            text-decoration: none;\n            font-weight: 600;\n        }\n        .external-link a:hover {\n            text-decoration: underline;\n        }\n\n        /* ─── RESPONSIVE ─── */\n        @media (max-width: 1024px) {\n            h1 { font-size: 3rem; }\n            h2 { font-size: 2.2rem; }\n            .grid-2 { grid-template-columns: 1fr; gap: 40px; }\n            .grid-2 .image-wrap { order: -1; }\n            .grid-2 .image-wrap img { height: 320px; }\n            .stats-bar { grid-template-columns: repeat(2, 1fr); }\n            .signalen-grid { grid-template-columns: 1fr 1fr; }\n        }\n\n        @media (max-width: 768px) {\n            h1 { font-size: 2.4rem; }\n            .hero { min-height: 70vh; padding: 60px 0; }\n            .hero-subtitle { font-size: 1.1rem; }\n            .hero-cta { flex-direction: column; align-items: center; }\n            .btn { width: 100%; max-width: 320px; justify-content: center; }\n            .grid-2x2 { grid-template-columns: 1fr; }\n            .cta-block { padding: 50px 24px; }\n            .cta-block .trust-badges { flex-direction: column; align-items: center; gap: 12px; }\n            section { padding: 50px 0; }\n            .stats-bar { grid-template-columns: 1fr 1fr; gap: 16px; }\n            .stat-item .number { font-size: 1.8rem; }\n            .grid-2 .image-wrap img { height: 240px; }\n            .signalen-grid { grid-template-columns: 1fr; }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.8rem; }\n            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }\n            .stats-bar { grid-template-columns: 1fr; }\n        }\n    </style>\n\n\n\n\n    <!-- ═══ HERO ═══ -->\n    <section class=\"hero\">\n        <div class=\"hero-bg\" loading=\"lazy\"></div>\n        <div class=\"hero-pattern\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                Gespecialiseerde SI-therapie\n            </div>\n            <h1><span>Sensorische Informatieverwerking</span> (SI) Therapie</h1>\n            <p class=\"hero-subtitle\">Professionele begeleiding bij prikkelverwerkingsproblemen voor kinderen van 4–18 jaar in Capelle aan den IJssel</p>\n            <div class=\"hero-cta\">\n                <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                <a href=\"/contact/\" class=\"btn btn-outline\">📅 Afspraak maken</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- ═══ MAIN CONTENT ═══ -->\n    <main class=\"container\">\n\n        <!-- ─── SECTIE 1: INTRO + STATS ─── -->\n        <section>\n            <div class=\"section-intro\">\n                <h2>Wat is sensorische informatieverwerking (SI) therapie?</h2>\n                <p>Bij Kids Fysio Capelle combineren we specialistische kennis met persoonlijke aandacht. Onze gespecialiseerde therapeuten helpen uw kind bij uiteenlopende uitdagingen in de ontwikkeling met <strong>sensorische informatieverwerking (SI) therapie</strong>.</p>\n            </div>\n\n            <div class=\"grid-2\">\n                <div class=\"text-content\">\n                    <h3>Hoe werkt SI-therapie bij kinderen?</h3>\n                    <p>Sensorische informatieverwerking (ook wel prikkelverwerking genoemd) is het proces waarbij prikkels die via uw lichaam binnenkomen worden verwerkt in de hersenen. Kinderen met sensorische informatieverwerkingsproblemen hebben zintuigen die niet optimaal samenwerken. <strong>SI-therapie</strong> helpt hierbij.</p>\n                    <p style=\"margin-top:16px;\">Wij zijn gespecialiseerde therapeuten en helpen kinderen van 4-18 jaar om de prikkelverwerking te verbeteren met <strong>sensorische informatieverwerking (SI) therapie</strong> in Capelle aan den IJssel.</p>\n                    <div style=\"display:inline-flex;align-items:center;gap:10px;padding:12px 24px;background:var(--primary-bg);border-radius:100px;margin-top:20px;font-weight:600;color:var(--primary);\">\n                        ✓ 18 behandelingen vergoed\n                    </div>\n                </div>\n                <div class=\"image-wrap\">\n                    <img src=\"/images/Setting-voor-SI-therapie-bij-Kids-Fysio-Capelle.png\" alt=\"Sensorische informatieverwerking (SI) therapie bij Kids Fysio Capelle in Capelle aan den IJssel\" loading=\"lazy\">\n                </div>\n            </div>\n\n            <!-- Stats Balk -->\n            <div class=\"stats-bar\">\n                <div class=\"stat-item\">\n                    <span class=\"number\">18</span>\n                    <span class=\"label\">Behandelingen vergoed</span>\n                </div>\n                <div class=\"stat-item\">\n                    <span class=\"number\">4-18</span>\n                    <span class=\"label\">Leeftijd kinderen</span>\n                </div>\n                <div class=\"stat-item\">\n                    <span class=\"number\">✓</span>\n                    <span class=\"label\">Geen verwijzing nodig</span>\n                </div>\n                <div class=\"stat-item\">\n                    <span class=\"number\">100%</span>\n                    <span class=\"label\">Persoonlijke aandacht</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- ─── SECTIE 2: SIGNALEN (2x2 grid) ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Herkenbare signalen bij sensorische informatieverwerking</h2>\n                <p>Kinderen met sensorische informatieverwerkingsproblemen kunnen verschillende signalen vertonen. Herkent u deze bij uw kind?</p>\n            </div>\n\n            <div class=\"signalen-grid\">\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Schrikken van geluiden</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Moeite met concentreren</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Overgevoeligheid voor licht</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Overgevoeligheid voor aanraking</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Constant in beweging moeten zijn</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Problemen met smaken of texturen</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Nauwelijks reageren bij aanspreken</div>\n                <div class=\"signaal-item\"><span class=\"check\">✓</span> Moeite met nieuwe situaties</div>\n            </div>\n\n            <p style=\"text-align:center; margin-top:30px; color:var(--text-muted);\">\n                Herkent u deze signalen? <a href=\"/contact/\" style=\"color:var(--primary);font-weight:600;\">Neem contact op</a> voor een vrijblijvend gesprek over <strong>sensorische informatieverwerking (SI) therapie</strong>.\n            </p>\n        </section>\n\n        <!-- ─── SECTIE 3: AANPAK (2x2 grid) ─── -->\n        <section style=\"padding-top:20px;\">\n            <div class=\"section-intro\">\n                <h2>Onze aanpak bij SI-therapie</h2>\n                <p>Wij werken volgens een bewezen methode die aansluit bij de belevingswereld van uw kind.</p>\n            </div>\n\n            <div class=\"grid-2x2\">\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🧠</span>\n                    <h4>Prikkelverwerking inzichtelijk</h4>\n                    <p>We maken samen met uw kind inzichtelijk hoe prikkels worden verwerkt en waar de uitdagingen liggen binnen de <strong>sensorische informatieverwerking (SI) therapie</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🎯</span>\n                    <h4>Spelenderwijs oefenen</h4>\n                    <p>Door middel van gerichte oefeningen en spel leren we uw kind omgaan met prikkels tijdens de <strong>sensorische informatieverwerking (SI) therapie</strong>.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">👨‍👩‍👧</span>\n                    <h4>Ouderbegeleiding</h4>\n                    <p>We betrekken ouders actief bij de behandeling en geven praktische tips voor thuis om de <strong>sensorische informatieverwerking (SI) therapie</strong> te ondersteunen.</p>\n                </div>\n                <div class=\"feature-card\">\n                    <span class=\"icon\">🤝</span>\n                    <h4>Multidisciplinaire aanpak</h4>\n                    <p>Indien nodig werken we samen met andere specialisten om de beste zorg te bieden binnen de <strong>sensorische informatieverwerking (SI) therapie</strong>.</p>\n                </div>\n            </div>\n        \n\n        <!-- ─── CTA ─── -->\n        <section style=\"padding:40px 0 80px;\">\n            <div class=\"cta-block\">\n                <div class=\"cta-inner\">\n                    <h2>Heeft uw kind moeite met prikkelverwerking?</h2>\n                    <p>Onze gespecialiseerde therapeuten helpen uw kind met <strong>sensorische informatieverwerking (SI) therapie</strong> om beter om te gaan met prikkels en zich optimaal te ontwikkelen.</p>\n                    <div class=\"btn-group\">\n                        <a href=\"tel:0103032575\" class=\"btn btn-primary\">📞 Bel 010-303 2575</a>\n                        <a href=\"mailto:info@kidsfysiocapelle.nl\" class=\"btn btn-secondary\">✉️ Stuur een e-mail</a>\n                        <a href=\"/contact/\" class=\"btn btn-secondary\">📅 Afspraak maken</a>\n                    </div>\n                    <div class=\"trust-badges\">\n                        <span>✓ Vergoed door alle zorgverzekeraars</span>\n                        <span>✓ Geen wachtlijst</span>\n                        <span>✓ Gespecialiseerde therapeuten</span>\n                        <span>✓ Kindvriendelijke omgeving</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- ─── SCRIPT ─── -->", "scripts": ["document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.feature-card, .signaal-item');\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.style.opacity = '1';\n                        entry.target.style.transform = 'translateY(0)';\n                    }\n                });\n            }, { threshold: 0.1 });\n\n            elements.forEach(el => {\n                el.style.opacity = '0';\n                el.style.transform = 'translateY(24px)';\n                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n                observer.observe(el);\n            });\n        });"]}